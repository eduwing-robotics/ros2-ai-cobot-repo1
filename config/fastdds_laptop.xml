<?xml version="1.0" encoding="UTF-8"?>
<!-- This laptop: ROS cell Wi-Fi + wired Ethernet, never the GoPro-only WLAN.
     Keep SHM for local camera/ROI/control. UDP congestion drops packets instead
     of stalling DDS writers; existing freshness watchdogs still reject loss.
     Once the TurtleBot Ethernet address is configured, remove wlo1 from this
     allowlist (and use the wired-only companion profile) to force that path. -->
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <profiles>
    <transport_descriptors>
      <transport_descriptor>
        <transport_id>ksmc_udp</transport_id>
        <type>UDPv4</type>
        <interfaceWhiteList>
          <interface>lo</interface>
          <interface>wlo1</interface>
          <interface>enp129s0</interface>
        </interfaceWhiteList>
        <non_blocking_send>true</non_blocking_send>
      </transport_descriptor>
      <transport_descriptor>
        <transport_id>ksmc_shm</transport_id>
        <type>SHM</type>
      </transport_descriptor>
    </transport_descriptors>
    <participant profile_name="ksmc_laptop" is_default_profile="true">
      <rtps>
        <userTransports>
          <transport_id>ksmc_udp</transport_id>
          <transport_id>ksmc_shm</transport_id>
        </userTransports>
        <useBuiltinTransports>false</useBuiltinTransports>
      </rtps>
    </participant>
  </profiles>
</dds>
