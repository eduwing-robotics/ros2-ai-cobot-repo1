# Copy this file to config/ksmc.env and edit only values that differ.
export KSMC_ROS_DISTRO=jazzy
export ROS_DOMAIN_ID=5
# All cell computers exchange ROS camera/control topics over the subnet.
# Keep ROS_LOCALHOST_ONLY at 0 on viewer and robot-control PCs.
export ROS_LOCALHOST_ONLY=0
export ROS_AUTOMATIC_DISCOVERY_RANGE=SUBNET
# Optional Fast DDS profile for the laptop cell. It keeps local SHM, excludes
# the GoPro-only WLAN and uses non-blocking UDP; enable only after matching the
# robot's actual interfaces. The checked-in profile currently permits the cell
# Wi-Fi and wired enp129s0 while the robot Ethernet address is pending.
# export KSMC_FASTDDS_PROFILE="${KSMC_ROOT}/config/fastdds_laptop.xml"
# After the robot has a verified 10.77.5.2/30 Ethernet address on both ROS
# participants, this wired-only profile keeps Wi-Fi up for SSH while ROS uses
# only enp129s0:
# export KSMC_FASTDDS_PROFILE="${KSMC_ROOT}/config/fastdds_laptop_wired.xml"

# S22 scrcpy USB settings (example values only).
export PHONE_SERIAL=CHANGE_ME
export DEVICE=/dev/video10

# The Full-HD topic is capped and isolated for close analysis. The 960x540
# control stream is the only continuous stop-detection input.
export S22_SIZE=1920x1080
export S22_FPS=30
export S22_JPEG_QUALITY=95
# The stop detector and dashboard render at 960 px. Keeping the live control
# stream at that width avoids dropping large best-effort DDS fragments; the
# full 1920x1080 stream remains available on /camera2/image_raw/compressed.
export S22_STREAM_SIZE=960x540
export S22_STREAM_JPEG_QUALITY=84
export S22_ANALYSIS_FPS=5
export S22_CAMERA_ID=0
export S22_CAMERA_ZOOM=1.5
export S22_SOURCE_SIZE=1920x1080
export S22_SOURCE_FPS=30
export S22_VIDEO_CODEC=h264
export S22_VIDEO_BIT_RATE=30M
export S22_INSPECTION_DIR="$HOME/KSMC/runtime/inspection"
export S22_CAMERA_CONTROL_DIR="$HOME/KSMC/runtime/s22_camera_control"
export S22_INSPECTION_ZOOM="3.5"
export S22_EXTRACT_INSPECTION_ROI="1"

# D435 camera-host relay. Keep exact RGB-D processing local and send only this
# high-quality latest-frame JPEG stream to the remote AI/viewer computer.
export D435_REMOTE_FPS=15
export D435_REMOTE_JPEG_QUALITY=92

# Optional network notes; current scripts discover ROS through DDS.
export FR5_IP=192.168.58.2
export TURTLEBOT_IP=192.168.11.101
