# Copy this file to config/ksmc.env and edit only values that differ.
export KSMC_ROS_DISTRO=jazzy
export ROS_DOMAIN_ID=5

# S22 DroidCam USB settings (example values only).
export PHONE_SERIAL=CHANGE_ME
export PHONE_PORT=4747
export PHONE_IP=192.168.11.7
export DEVICE=/dev/video10
export SIZE=1920x1080
export FPS=30
export JPEG_QUALITY=95

# Optional network notes; current scripts discover ROS through DDS.
export FR5_IP=192.168.58.2
export TURTLEBOT_IP=192.168.11.101
