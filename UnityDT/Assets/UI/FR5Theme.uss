/*
  FR5 공용 테마 — Docs/ui/mock-01-run.svg 에서 확정한 패널 언어.

  원칙 (Docs/UI.md 6절)
    · 대비를 배경에 맡기지 않는다. 패널은 완전히 불투명한 계기 표면이다.
      트윈에서 배경은 변수이므로 스크림·글자그림자로는 가독성이 상수가 되지 않는다.
      알파를 조금이라도 남기면 밝은 셀 렌더가 그만큼 비쳐 대비가 배경에 종속된다.
    · 액센트(MOCK 노랑 / REAL 파랑)는 모드와 "지금 여기"에만 쓴다.
    · 정상에는 색을 주지 않는다(--c-ok 는 회색). 이상만 색을 얻는다.
    · 테두리는 "눌러야 하는 것"에만 붙인다.

  격자: 상단 바 64 / 페이지 레일 88 / 여백 24 → 좌 112, 우 1896
  PanelSettings 는 ScaleWithScreenSize · 1920x1080 이므로 px 가 목업과 1:1 이다.
*/

/*
  변수는 :root 뿐 아니라 .page 에도 건다.
  <ui:Style> 로 붙인 스타일시트에서 :root 가 항상 페이지 루트에 걸리지는 않아
  var() 가 통째로 해석되지 않고 패널이 투명해지는 일이 있었다.
*/
:root, /*
  <ui:Instance> 는 TemplateContainer 로 들어가며 기본이 흐름 배치다.
  그대로 두면 셸이 내용 높이(45px)로 눌려 레일이 잘린다.
*/
.shell-host {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
}

.page {
    /* 알파 없음. 0.97 은 밝은 배경 위에서 실측 밝기 편차 5, 페이지에 따라 45 까지 벌어졌다 */
    --c-panel: rgb(10, 15, 20);
    --c-sunk: rgba(255, 255, 255, 0.05);
    --c-sunk-2: rgba(255, 255, 255, 0.07);
    --c-line: rgba(255, 255, 255, 0.09);
    --c-edge: rgba(255, 255, 255, 0.16);

    /*
      ink-3 는 화면의 모든 라벨(.micro · .sect__title · .panel__badge · 표 머리)이다.
      11~12px 로 쓰이므로 본문 기준 4.5:1 을 넘겨야 한다. 이전 값 rgb(96,112,124) 는
      패널 위에서 3.0:1 이라 현장 조명에서 읽히지 않았다.
      ink-4 는 비활성·부연이라 그래픽 기준 3:1 만 넘긴다 (이전 2.0:1).
    */
    --c-ink: rgb(226, 236, 241);
    --c-ink-2: rgb(147, 165, 178);
    --c-ink-3: rgb(132, 148, 160);
    --c-ink-4: rgb(100, 112, 122);

    --c-real: rgb(58, 150, 255);
    --c-mock: rgb(250, 204, 51);
    --c-accent: var(--c-real);

    /*
      액센트의 "채움"도 변수여야 한다.

      USS 에는 color-mix 도 rgba(var(--x), a) 도 없어서, 지금까지 칩·버튼·선택행의
      배경이 rgba(250,204,51,...) 로 직접 적혀 있었다. 그래서 REAL 로 바꾸면 테두리와
      글자만 파랗게 변하고 채움은 노란 채로 남아, 한 화면에 액센트가 둘이 됐다.
      (액센트가 둘이면 어느 쪽도 "지금 여기"를 뜻하지 못한다.)
    */
    --c-accent-fill: rgba(58, 150, 255, 0.16);
    --c-accent-wash: rgba(58, 150, 255, 0.10);
    --c-accent-tint: rgba(58, 150, 255, 0.07);

    --c-ok: rgb(143, 166, 180);
    --c-warn: rgb(246, 173, 55);
    --c-bad: rgb(240, 71, 90);
    --c-bad-ink: rgb(255, 143, 155);

    --fs-micro: 11px;
    --fs-label: 12px;
    --fs-body: 15px;
    --fs-value: 20px;
}

.fr5--mock {
    --c-accent: var(--c-mock);
    --c-accent-fill: rgba(250, 204, 51, 0.16);
    --c-accent-wash: rgba(250, 204, 51, 0.10);
    --c-accent-tint: rgba(250, 204, 51, 0.07);
}

.page {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--c-ink-2);
    font-size: var(--fs-body);
}

/*
  조회 화면(INSPECT · QUALITY)의 배경 스크림.

  RUN · MANUAL 에서 트윈은 근거다 — 로봇이 실제로 어떻게 움직이는지가 화면의 내용이다.
  그러나 불량률 표와 판정 목록을 보는 동안 뒤에서 밝은 셀 렌더가 계속 움직이는 것은
  정보가 아니라 소음이다. 움직임은 시선을 끌기 때문에 값을 읽는 일과 경쟁한다.

  트윈을 끄지는 않는다. 어디를 보고 있는지는 남겨 두고 밝기만 눌러, 패널 사이 여백으로
  새어 들어오던 밝은 면을 계기와 같은 어둠으로 되돌린다.
*/
.page--dim { background-color: rgba(8, 12, 16, 0.82); }

/*
  트윈 집중(declutter) — 상단 바의 TWIN 칩이 페이지 뿌리에 .page--focus 를 붙인다.

  왜 필요한가. 이 화면은 계기이면서 동시에 트윈이다. 계기를 다 펼치면 RUN 에서 화면의
  절반, MANUAL 에서 3/4 이 불투명한 패널로 덮인다 — 로봇을 보면서 조그하라고 만든
  화면인데 정작 로봇이 안 보였다.

  패널을 반투명하게 만드는 방향은 이미 한 번 실패했다(위 --c-panel 주석). 대비를
  배경에 맡길 수 없으니 남는 답은 하나다: 덮는 넓이 자체를 줄인다. 항공 HUD 연구가
  declutter 모드를 "있으면 좋은 것"이 아니라 요건으로 두는 이유와 같고, 3D 도구들이
  전부 패널 접기 단축키를 두는 이유와도 같다.

  무엇을 지우는가. 지금 당장 봐야 하는 것(로봇 상태 · 작업 · 조그)은 남기고, 궁금할 때
  찾아보는 것(영상 · 이벤트 · 이력 · 진행 표)만 .panel--aux 로 표시해 지운다.
  상단 바 · 페이지 레일 · 알람 띠는 절대 지우지 않는다 — 알람이 declutter 로 사라지면
  declutter 가 위험이 된다.

  visibility 가 아니라 display 다. visibility 는 자리를 남겨 아래 패널이 밀리지 않지만,
  여기서는 자리 자체가 목적이다.
*/
.page--focus .panel--aux { display: none; }

/* 집중 중에는 조회 화면의 스크림도 걷는다 — 스크림은 패널을 읽을 때만 필요하다. */
.page--focus.page--dim { background-color: rgba(8, 12, 16, 0.35); }

/*
  flex-shrink 를 0 으로 둔다. 세로로 쌓인 계기에서 이 값이 1 이면, 내용이 한 줄만
  넘쳐도 구분선·섹션 제목·게이지가 height 0 으로 눌려 조용히 사라진다.
  (ROBOT 패널이 실제로 이 상태였다. 넘침은 잘리는 편이 낫다 — 보이니까 고친다)
*/
.row { flex-direction: row; align-items: center; flex-shrink: 0; }
.spacer { flex-grow: 1; }
.rule { height: 1px; background-color: var(--c-line); flex-shrink: 0; }

/* ============================ 패널 ============================ */

.panel {
    background-color: var(--c-panel);
    border-width: 1px;
    border-color: var(--c-line);
}

/* 좌측 3px 액센트 척추. 헤더 박스를 따로 세우지 않는다. */
.panel__spine {
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 3px;
    background-color: var(--c-accent);
}

.panel__head {
    height: 40px;
    flex-direction: row;
    align-items: center;
    padding-left: 18px;
    padding-right: 14px;
    border-bottom-width: 1px;
    border-bottom-color: var(--c-line);
}

.panel__title {
    color: var(--c-ink-2);
    font-size: var(--fs-label);
    letter-spacing: 1.4px;
    -unity-font-style: bold;
}

.panel__badge { color: var(--c-ink-3); font-size: var(--fs-micro); letter-spacing: 1.2px; }
.panel__body { padding: 18px; flex-grow: 1; }

/* 섹션 제목 — 2px 액센트 조각 + 라벨 */
.sect { flex-direction: row; align-items: center; margin-bottom: 10px; flex-shrink: 0; }
.sect__tick { width: 2px; height: 11px; background-color: var(--c-accent); opacity: 0.8; margin-right: 8px; }
.sect__title { color: var(--c-ink-3); font-size: var(--fs-micro); letter-spacing: 1.2px; -unity-font-style: bold; }
.sect__unit { color: var(--c-ink-3); font-size: var(--fs-micro); letter-spacing: 1.2px; }

/* ============================ 텍스트 ============================ */

/*
  포괄 규칙(.page Label)은 쓰지 않는다. 특이성이 (0,1,1)이라 .value / .micro 같은
  단일 클래스 규칙(0,1,0)을 전부 이겨 글자 크기가 한 값으로 눌린다.
  기본값은 상속되는 .page 에 걸어 클래스 규칙이 항상 이기게 한다.
*/
.micro { color: var(--c-ink-3); font-size: var(--fs-micro); letter-spacing: 1.2px; -unity-font-style: bold; }
.muted { color: var(--c-ink-3); font-size: 13px; }
.value { color: var(--c-ink); font-size: var(--fs-value); -unity-font-style: bold; }
.value--lg { font-size: 28px; }
.value--xl { font-size: 52px; letter-spacing: -2px; }
.accent { color: var(--c-accent); -unity-font-style: bold; }
.bad { color: var(--c-bad-ink); -unity-font-style: bold; }
.warn { color: var(--c-warn); -unity-font-style: bold; }
.mono { -unity-font-definition: initial; font-size: 13px; }

/* ============================ 조각 ============================ */

.dot { width: 8px; height: 8px; border-radius: 4px; background-color: var(--c-ink-4); }
.dot--ok { background-color: var(--c-ok); }
.dot--good { background-color: rgb(62, 207, 142); }
.dot--warn { background-color: var(--c-warn); }
.dot--bad { background-color: var(--c-bad); }

.gauge { height: 7px; background-color: var(--c-sunk-2); flex-shrink: 0; }
.gauge__fill { height: 7px; width: 0; background-color: var(--c-accent); }
.gauge__fill--neutral { background-color: var(--c-ok); }
.gauge__fill--warn { background-color: var(--c-warn); }

.chip {
    height: 24px;
    padding-left: 10px; padding-right: 10px;
    align-items: center; justify-content: center;
    border-width: 1px;
    border-color: var(--c-edge);
    background-color: rgba(255, 255, 255, 0.04);
}
.chip__text { color: var(--c-ink-2); font-size: var(--fs-micro); letter-spacing: 1.1px; -unity-font-style: bold; }
/* 누를 수 있는 칩(MODE · TWIN)만 반응한다. 상태 표시용 칩은 Button 이 아니라 무반응이다. */
Button.chip { transition-property: background-color; transition-duration: 120ms; }
Button.chip:hover { background-color: rgba(255, 255, 255, 0.09); }
Button.chip:active { background-color: rgba(255, 255, 255, 0.15); }
.chip--accent { border-color: var(--c-accent); background-color: var(--c-accent-fill); }
.chip--accent .chip__text { color: var(--c-accent); }
.chip--bad { border-color: var(--c-bad); background-color: rgba(240, 71, 90, 0.14); }
.chip--bad .chip__text { color: var(--c-bad-ink); }
.chip--good { border-color: rgb(62, 207, 142); background-color: rgba(62, 207, 142, 0.12); }
.chip--good .chip__text { color: rgb(62, 207, 142); }

/* 테두리는 눌러야 하는 것에만 */
.btn {
    height: 40px;
    margin: 0;
    padding: 0;
    border-width: 1px;
    border-color: var(--c-edge);
    background-color: rgba(255, 255, 255, 0.05);
    color: var(--c-ink);
    font-size: 13px;
    letter-spacing: 1.4px;
    -unity-font-style: bold;
}
/*
  눌린 느낌.

  이 화면은 터치 패널에서도 쓴다. 터치에는 hover 가 없으므로, 눌렀다는 확인이
  :hover 에만 있으면 손가락으로는 아무 확인도 못 받는다. :active 를 따로 준다.
  전환은 120ms 다 — 계기에서 애니메이션은 값보다 늦으면 안 되고, 0ms 면 눌렀는지
  안 눌렸는지 구분이 안 된다.
*/
.btn { transition-property: background-color, border-color; transition-duration: 120ms; }
.btn:hover { background-color: rgba(255, 255, 255, 0.1); }
.btn:active { background-color: rgba(255, 255, 255, 0.18); border-color: var(--c-edge); }
.btn--accent:active { background-color: var(--c-accent-fill); border-color: var(--c-accent); }
.btn--danger:active { background-color: rgba(240, 71, 90, 0.24); }
.btn:disabled { border-color: var(--c-line); background-color: rgba(255, 255, 255, 0.02); color: var(--c-ink-4); }
.btn--accent { border-color: var(--c-accent); background-color: var(--c-accent-fill); color: var(--c-accent); }
.btn--danger { border-color: rgba(240, 71, 90, 0.55); background-color: rgba(240, 71, 90, 0.1); color: var(--c-bad-ink); }

/* 밑줄 탭 */
/* margin-right 는 지웠다 — 가로 탭 시절 값이라 세로 레일에서는 탭을 14px 왼쪽으로 밀 뿐이다. */
.tab { background-color: rgba(0, 0, 0, 0); border-width: 0; padding: 0; margin: 0; align-items: flex-start; transition-property: background-color; transition-duration: 120ms; }
#navrail .tab:hover { background-color: rgba(255, 255, 255, 0.05); }
#navrail .tab:active { background-color: rgba(255, 255, 255, 0.09); }
#navrail .tab--on { border-width: 1px; border-color: var(--c-accent); border-radius: 6px; background-color: var(--c-accent-wash); }
.tab__text { color: rgb(130, 150, 166); font-size: 13px; letter-spacing: 1.6px; -unity-font-style: bold; }
.tab__bar { height: 2px; width: 0; margin-top: 6px; background-color: var(--c-accent); }
.tab--on .tab__text { color: var(--c-accent); }

/*
  레일 아이콘 — Siemens iX (MIT). Assets/UI/Icons/README.md 참고.

  이전에는 VisualElement 를 겹쳐 손으로 그렸다. 7개가 서로 굵기와 여백이 달랐고
  새 항목마다 좌표를 손으로 맞춰야 했다. 지금은 한 벌에서 나온 이미지다.

  색은 이미지가 아니라 tint 가 정한다. 이미지에 색을 구우면 활성 탭이
  --c-accent 를 따라가지 못해 모드 전환(MOCK 노랑 / REAL 파랑)에서 어긋난다.
*/
.tab__icon {
    width: 26px;
    height: 26px;
    flex-shrink: 0;
    margin-bottom: 6px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(132, 148, 160);
}
.tab--on .tab__icon { -unity-background-image-tint-color: var(--c-accent); }

/*
  슬롯 칩 — 완성체의 장착 위치 하나.
  같은 그림을 요청 · 검사 · 품질이 재사용한다 (Docs/UI.md 5.3).
*/
.slotchip {
    width: 138px;
    height: 62px;
    margin-right: 8px;
    margin-bottom: 8px;
    padding-left: 10px;
    justify-content: center;
    border-left-width: 3px;
    border-left-color: rgba(143, 166, 180, 0.45);
    background-color: rgba(255, 255, 255, 0.035);
}
.slotchip--target { border-left-color: var(--c-accent); background-color: var(--c-accent-wash); }
.slotchip--bad { border-left-color: var(--c-bad); background-color: rgba(240, 71, 90, 0.10); }
.slotchip__code { color: var(--c-ink); font-size: 13px; -unity-font-style: bold; }
.slotchip__part { color: var(--c-ink-3); font-size: 11px; margin-top: 3px; }
.tab--on .tab__bar { width: 100%; }

/*
  조립 진행 — 부품 타입 하나가 묶음 하나, 칸 하나가 슬롯 하나다.
  레시피의 한 스텝이 곧 슬롯 하나이므로 칸을 세는 것이 곧 스텝을 세는 것이다
  (Docs/Recipe.md). 같은 칸 어휘를 INSPECT · QUALITY 의 슬롯 맵이 재사용한다.
*/
.grp { flex-grow: 1; flex-shrink: 0; margin-right: 16px; }
.grp__head { flex-direction: row; align-items: center; margin-bottom: 9px; }
.grp__name { color: var(--c-ink-2); font-size: var(--fs-micro); letter-spacing: 1.2px; -unity-font-style: bold; }
.grp__count { color: var(--c-ink-3); font-size: var(--fs-micro); -unity-font-style: bold; }
.grp__cells { flex-direction: row; align-items: center; }
/* 액센트는 "지금 여기" 하나에만 — 진행 중인 묶음이다 */
.grp--now .grp__name { color: var(--c-accent); }
.grp--now .grp__count { color: var(--c-ink); }

/* 놓인 칸은 회색이다. 정상에는 색을 주지 않는다 */
.cell { width: 15px; height: 15px; margin-right: 4px; background-color: var(--c-sunk-2); flex-shrink: 0; }
.cell--done { background-color: var(--c-ok); }
.cell--now { background-color: var(--c-accent); }
.cell--bad { background-color: var(--c-bad); }

/* 표 — 세로줄과 바깥 테두리를 두지 않는다 */
.trow { flex-direction: row; align-items: center; min-height: 42px; flex-shrink: 0; border-bottom-width: 1px; border-bottom-color: rgba(255, 255, 255, 0.055); }
.trow--head { height: 28px; border-bottom-color: var(--c-line); }
.trow--sel { background-color: var(--c-accent-tint); }
.trow--bad { background-color: rgba(240, 71, 90, 0.08); }
/*
  칸은 넘치면 잘린다. 기본값이면 Label 이 제 너비를 넘어 옆 칸 위로 그려져서 두 칸의
  글자가 겹친다 (PART DEFECT RATE 의 부품명 · 유형이 실제로 이 상태였다).
  겹친 글자는 둘 다 못 읽지만, 잘린 글자는 잘렸다는 것이 보인다.
*/
.tcell {
    color: var(--c-ink-2);
    font-size: 14px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}
.tcell--head { color: var(--c-ink-3); font-size: 10px; letter-spacing: 1.2px; -unity-font-style: bold; }
.tcell--num { -unity-text-align: middle-right; color: var(--c-ink); -unity-font-style: bold; }

/* 빈 상태 — 0 을 그리지 않는다 */
/*
  런타임에 자식이 채워지는 컨테이너. flex 기본값(shrink:1)이면 형제가 커질 때
  이 컨테이너가 눌리고 자식이 밖으로 넘쳐 다음 섹션과 겹친다.
*/
.vlist { flex-shrink: 0; }

.empty { flex-grow: 1; align-items: center; justify-content: center; }
.empty__title { color: var(--c-ink-3); font-size: 16px; -unity-font-style: bold; letter-spacing: 1.4px; }
.empty__desc { color: var(--c-ink-4); font-size: 13px; margin-top: 10px; }
/*
  조회 경로가 아직 없는 자리.

  이전에는 warn(노랑)이었다. 그런데 미연결 자리가 한 화면에 3~4개씩 있어(QUALITY 4개,
  INSPECT 3개) 화면이 통째로 노래졌고, 그러면 진짜 이상이 묻힌다 — 붉은색을 아껴 둔
  이유와 정확히 같은 이유로 노란색도 아껴야 했다. 게다가 이 노랑은 MOCK 모드 액센트와
  같은 계열이라 "지금 MOCK" 신호까지 함께 흐려졌다.

  부재는 이상이 아니라 없음이다. 그래서 무채색으로 두되, 본문(--c-ink-3)보다 한 단계
  밝게 해서 "이 자리의 주된 낱말"이라는 것만 남긴다. 무엇이 없는지는 .empty__desc 가
  적는다 — 색이 아니라 글자가 설명하게 한다.
*/
.empty__title--miss { color: var(--c-ink-2); }

/* 값 한 칸이 비어 있을 때. 위와 같은 이유로 무채색이다 (FR5EmptyState.Missing) */
.miss { color: var(--c-ink-2); }

/* ========================= RUN 전용 =========================
   여기 규칙은 전부 run- 으로 시작하고 .page--run 안에서만 쓴다.
   요청 · 검사 · 품질은 공용 .panel 을 그대로 쓰므로 영향을 받지 않는다.

   왜 RUN 만 다른가.
   표를 읽는 화면(요청 · 검사 · 품질)에서 트윈은 소음이고, 그래서 그 화면들은
   패널로 덮고 page--dim 으로 눌러 둔다. 그러나 RUN 에서 "로봇이 지금 무엇을
   하고 있는가"의 답은 절반이 트윈에 있다. 계기를 상자에 담아 트윈 위에 띄우면
   답의 절반을 가리게 된다. 그래서 상자를 없애고 화면 양 가장자리에 얹는다.

   왜 알파를 다시 쓰는가.
   패널을 불투명하게 만든 이유는 밝은 셀 렌더가 비쳐 대비가 배경에 종속되기
   때문이었다. 그 조건 자체를 없애는 대신 최악의 경우를 재고 그 안에서 쓴다.
   스크림 rgba(6,10,14,0.88) 이 순백(255,255,255) 위에 놓인 최악의 합성은
   rgb(36,39,43) 이고, 그 위에서 ink 12.5:1 · ink-3 4.8:1 이다. 본문 기준
   4.5:1 을 배경이 무엇이든 넘긴다 — 비네트에도, 카메라 각도에도 기대지 않는다.

   0.88 을 낮추지 말 것. 0.86 에서 이미 4.49:1 로 기준에 걸치고 0.78 이면
   3.3:1 이다. 한때 비네트를 0.62 로 올리고 0.82 로 낮춘 적이 있는데(실측
   5.8:1), 그때는 가독성이 후처리 설정 하나에 매달려 있었다. 비네트를 되돌리면서
   이 값도 함께 되돌렸다. */

.run-edge {
    position: absolute;
    background-color: rgba(6, 10, 14, 0.88);
}

/*
  레일에 딱 붙인다. 24px 여백을 두면 계기가 다시 "떠 있는 상자"가 된다.

  bottom 을 잡지 않는다. 화면 아래까지 늘리면 Mock 에서 TCP·RPY·SAFETY 가 접힌
  만큼(약 420px) 열 한가운데가 텅 비고, 상자가 없어진 지금은 그 구멍이 더 도드라진다.
  내용 높이에 맞춰 끝내면 남는 자리는 구멍이 아니라 트윈이 이어지는 자리가 된다.
  Mock/Real 사이에 높이가 달라지지만 모드는 에디터에서만 바뀌므로 실행 중에는 고정이다.
*/
.run-edge--left {
    left: 88px; top: 68px; width: 412px;
    padding-left: 28px; padding-right: 28px;
    padding-top: 22px; padding-bottom: 18px;
    /* 아래에 카메라 타일(y772)이 있다. 넘치면 눌리지 않고 삐져나와 눈에 보인다. */
    max-height: 704px;
    overflow: hidden;
}

.run-edge--right {
    right: 0; top: 68px; bottom: 0; width: 360px;
}

/* 조립 진행. 트윈 위에 얹혀 화면 아래 가장자리를 덮는다. */
/*
  이중 시야 배치에서 계기 띠는 트윈 위에 얹힌 가장자리 층이 아니라
  화면 폭을 차지하는 계기 선반이다. 그러므로 예외를 두지 않고 완전 불투명이다.
  0.88 로 두었을 때 밝은 작업대가 비쳐 IDLE · 슬롯 문구가 실제로 흐렸다.
*/
.run-deck {
    position: absolute;
    left: 88px; right: 0; bottom: 0; height: 270px;
    background-color: var(--c-panel);
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.10);
    padding-left: 26px; padding-right: 26px;
    padding-top: 14px; padding-bottom: 14px;
}

/* 진행 레일 — 화면에서 크게 움직이는 유일한 것.
   조립 진행(놓인 슬롯 / 전체)이다. 아직 연결되지 않은 jobs 진행이 아니다. */
.run-rail {
    position: absolute;
    left: 88px; top: 64px; right: 0; height: 4px;
    background-color: rgba(255, 255, 255, 0.07);
}
.run-rail__fill {
    height: 4px; width: 0;
    background-color: var(--c-accent);
    transition-property: width;
    transition-duration: 400ms;
}

/* 섹션 제목. 액센트 조각을 붙이지 않는다 — 액센트는 "지금 여기" 하나에만 쓴다.
   구분은 색이 아니라 자간과 규칙선이 한다. */
.run-sect { flex-direction: row; align-items: center; flex-shrink: 0; margin-bottom: 9px; }
.run-sect__title { color: var(--c-ink-2); font-size: 11px; letter-spacing: 2.2px; -unity-font-style: bold; }
.run-sect__unit { color: var(--c-ink-4); font-size: 11px; letter-spacing: 1.2px; }
.run-hr { height: 1px; background-color: rgba(255, 255, 255, 0.10); flex-shrink: 0; }

/* 타입 스케일을 벌린다. 이전에는 11 · 12 · 15 · 20 네 단계가 9px 안에 몰려 있어
   무엇이 중요한지 크기로 구별되지 않았다. */
.run-lead { color: var(--c-ink); font-size: 40px; -unity-font-style: bold; letter-spacing: -1.5px; }
.run-val { color: var(--c-ink); font-size: 22px; -unity-font-style: bold; }
.run-sub { color: var(--c-ink-3); font-size: 12px; }

/* 카메라. 영상은 자기 표면이 있으므로 테두리도 헤더도 주지 않는다.
   360 폭에 4:3 이라 270 이다. 이름은 영상 위에 얹는다. */
/*
  이전 배경 rgb(14,19,25) 는 열 스크림과 거의 같은 밝기라 타일 경계가 보이지 않았다.
  영상이 없을 때 "여기가 화면"이라는 것 자체가 읽히지 않는다. 열보다 확실히 어둡게
  내리고 아래에 규칙선을 하나 그어 오목한 면으로 만든다.
*/
.run-cam {
    height: 270px;
    background-color: rgb(3, 6, 9);
    flex-shrink: 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.10);
}
/* 태그는 영상 위에도 얹힌다. 밝은 프레임이 오면 글자가 씻기므로 자기 바탕을 갖는다. */
.run-cam__tag {
    position: absolute; left: 10px; top: 10px;
    color: rgb(205, 218, 226); font-size: 10px;
    letter-spacing: 1.8px; -unity-font-style: bold;
    background-color: rgba(3, 6, 9, 0.72);
    padding-left: 6px; padding-right: 6px;
    padding-top: 2px; padding-bottom: 2px;
}

/* 추세 — 값 하나의 최근 이력 (Sparkline.cs, Docs/ui-design.md 3.1절).
   값만 보여 주면 "지금 얼마인가"만 알고 "어느 쪽으로 가고 있는가"는 모른다.
   그래서 이상을 알람이 뜬 뒤에야 알아챈다.

   22px 는 세로 예산에서 나온 값이다. 기울기가 읽히는 최소 높이이고, 더 키우면
   좌측 열에서 관절 6행(156px)이 가져갈 몫을 뺏는다. Real 에서 열 전체가
   704px(카메라 타일 위)에 들어가야 한다. */
.spark { height: 22px; flex-shrink: 0; }


/* ===== MONITOR 재구성 (Docs/ui-design.md 2절) ===== */

/*
  "지금" 띠 — 무엇을, 어디에. 트윈 바로 위에 얹어 3D 를 보는 시선과 같은
  시야에 들어오게 한다. 우측 열을 없앤 자리가 여기로 왔다.
*/
.run-now {
    position: absolute;
    left: 500px; right: 0; top: 68px; height: 96px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(6, 10, 14, 0.88);
    padding-left: 28px; padding-right: 28px;
}
.run-now__phase { color: var(--c-ink-2); font-size: 13px; letter-spacing: 2.4px; -unity-font-style: bold; }
/*
  화면에서 가장 큰 글자다. 실패했을 때 사람이 갈 좌표이고, DB · 레시피 · 검사가
  모두 같은 값을 쓴다. 이전에는 12px 로 "step 7 / 25 · slot HBM-03" 안에 묻혀 있었다.
*/
.run-now__slot { color: var(--c-ink); font-size: 38px; -unity-font-style: bold; letter-spacing: -0.5px; }
.run-now__part { color: var(--c-ink-3); font-size: 15px; margin-left: 18px; }
.run-now__count { color: var(--c-ink); font-size: 26px; -unity-font-style: bold; }

/*
  카메라 타일. 좌측 계기 열 아래, 화면 왼쪽 아래 모서리에 고정한다.
  트윈 위에 얹지 않는다 — 트윈을 지면으로 두기로 한 것이 이 배치의 전제다.
  412 x 308 은 4:3 이라 640x480 텍스처가 레터박스 없이 들어간다.
*/
.run-cam-panel {
    position: absolute;
    left: 88px; bottom: 0; width: 412px; height: 308px;
    background-color: rgba(6, 10, 14, 0.88);
    padding: 12px;
}
.run-cam-panel .run-cam { flex-grow: 1; height: auto; }
/* 소스 전환과 확대는 영상 위에 얹힌다. 자기 바탕을 갖는 칩이라 밝은 프레임에서도 읽힌다. */
.run-cam__bar {
    position: absolute;
    left: 8px; right: 8px; bottom: 8px;
    flex-direction: row;
    align-items: center;
}

/*
  확대 — 카메라와 트윈이 자리를 바꾼다. REAL 에서 "트윈이 놓았다고 하는데
  실제로 놓였나"를 크게 봐야 할 때 쓴다. 좌표는 트윈 자리 그대로다.
*/
.run-cam-panel--expanded {
    left: 500px; top: 164px; width: auto; height: auto;
    right: 0; bottom: 140px;
}


/* ===== MONITOR · 이중 시야 (Docs/ui-design.md 2절) =====
   좌우 두 그림이 같은 크기를 지키는 것이 이 배치의 전부다.
   크기가 다르면 사람이 한쪽을 먼저 보고, 그러면 비교가 아니라 확인이 된다. */

/*
  top 은 70 이 아니라 112 다. 70 은 셸의 alarm-banner(top:64 · height:44) 자리이고,
  그 띠는 로봇이 끊기면 켜진다. 두 창의 제목이 실제로 가려졌다.
  알람 띠 자리는 켜지든 안 켜지든 항상 비워 둔다 (Docs/ui-design.md 2절).
*/
.run-pane { position: absolute; top: 112px; height: 698px; }

/* 기준 쪽은 아무것도 덮지 않는다. 3D 트윈이 그대로 보이는 자리다. */
.run-pane--twin {
    left: 88px; width: 908px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.10);
    padding: 18px;
}
/* 관측 쪽만 액센트 테두리를 얻는다. 여기가 로봇의 자기 보고와 무관한 유일한 증거다. */
.run-pane--cam {
    left: 1012px; width: 908px;
    border-width: 2px;
    border-color: var(--c-accent);
    background-color: rgb(3, 6, 9);
    padding: 0;
}
.run-pane__title {
    position: absolute; left: 18px; top: 14px;
    color: var(--c-ink-2); font-size: 14px;
    letter-spacing: 2.2px; -unity-font-style: bold;
}
.run-pane__title--on { color: var(--c-accent); }
.run-pane__source {
    position: absolute; right: 18px; top: 16px;
    color: var(--c-ink-4); font-size: 12px;
}
.run-pane--cam .run-cam {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
    height: auto; border-bottom-width: 0;
}

/* 계기 띠의 열. 절대 배치라 열 하나가 접혀도 나머지가 밀리지 않는다. */
.run-col {
    position: absolute;
    top: 22px; bottom: 20px;
    padding-left: 22px; padding-right: 22px;
}
.run-col--rule { border-left-width: 1px; border-left-color: rgba(255, 255, 255, 0.09); }
