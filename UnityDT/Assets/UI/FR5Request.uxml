<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Style src="project://database/Assets/UI/FR5Theme.uss" />
    <ui:Template src="project://database/Assets/UI/FR5Shell.uxml" name="FR5Shell" />

    <ui:VisualElement name="fr5-request" class="page page--jobs fr5--mock">
        <ui:VisualElement class="page-heading">
            <ui:Label text="JOBS" class="page-heading__title" />
            <ui:Label text="/" class="page-heading__divider" />
            <ui:Label text="작업 현황" class="page-heading__title" />
            <ui:VisualElement class="spacer" />
            <ui:Label name="jobs-page-note" text="작업 선택 · 진행 확인 · 검사 기록" class="page-heading__meta" />
        </ui:VisualElement>

        <ui:VisualElement class="panel" style="position:absolute; left:112px; top:164px; width:1118px; height:868px;">
            <ui:VisualElement class="panel__spine" />
            <ui:VisualElement class="panel__head">
                <ui:Label text="작업 목록" class="panel__title" />
                <ui:Label name="job-count" text="—" class="panel__badge" style="margin-left:14px;" />
                <ui:VisualElement class="spacer" />
                <ui:Button name="job-refresh" text="새로고침" class="btn" style="width:112px; height:34px;" />
            </ui:VisualElement>
            <ui:VisualElement class="panel__body">
                <ui:VisualElement class="row" style="margin-bottom:14px;">
                    <ui:Button name="filter-all" text="전체" class="btn job-filter job-filter--on" />
                    <ui:Button name="filter-queue" text="대기 · 실행 중" class="btn job-filter" />
                    <ui:Button name="filter-attention" text="확인 필요" class="btn job-filter" />
                    <ui:Button name="filter-done" text="완료 · 취소" class="btn job-filter" />
                    <ui:VisualElement class="spacer" />
                </ui:VisualElement>

                <ui:Label name="job-error" text="" class="bad wrap" style="font-size:15px; flex-shrink:0;" />
                <ui:Label name="job-query-state" text="조회 중" class="jobs-support" />
                <ui:VisualElement class="trow trow--head jobs-columns">
                    <ui:Label text="상태" class="tcell tcell--head" style="width:110px;" />
                    <ui:Label text="제품 · 작업 ID" class="tcell tcell--head jobs-product-cell" />
                    <ui:Label text="PASS / 목표" class="tcell tcell--head" style="width:130px;" />
                    <ui:Label text="시도" class="tcell tcell--head" style="width:88px;" />
                    <ui:Label text="결과 요약" class="tcell tcell--head" style="width:160px;" />
                    <ui:Label text="등록 · 로컬" class="tcell tcell--head" style="width:132px;" />
                </ui:VisualElement>
                <ui:ScrollView mode="Vertical" class="jobs-list-scroll">
                    <ui:VisualElement name="job-list" class="vlist" />
                </ui:ScrollView>
                <ui:VisualElement name="job-detail" class="jobs-detail">
                    <ui:VisualElement class="row">
                        <ui:Label text="선택한 작업" class="jobs-support" />
                        <ui:VisualElement class="spacer" />
                        <ui:Label name="selected-job-status" text="선택 전" class="job-status" />
                    </ui:VisualElement>
                    <ui:Label name="selected-job-product" text="목록에서 작업을 선택하세요" class="jobs-detail-title" />
                    <ui:Label name="selected-job-id" text="—" class="jobs-support" />
                    <ui:VisualElement class="row jobs-metrics">
                        <ui:VisualElement class="jobs-metric">
                            <ui:Label text="달성 PASS / 목표 PASS" class="jobs-support" />
                            <ui:Label name="selected-job-progress" text="—" class="jobs-progress" />
                        </ui:VisualElement>
                        <ui:VisualElement class="jobs-metric">
                            <ui:Label text="생산 시도" class="jobs-support" />
                            <ui:Label name="selected-job-attempts" text="—" class="jobs-progress" />
                        </ui:VisualElement>
                        <ui:VisualElement class="jobs-metric">
                            <ui:Label text="검사 불합격 · 실행 실패" class="jobs-support" />
                            <ui:Label name="selected-job-results" text="—" class="jobs-progress jobs-results" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Label name="selected-job-reason" text="선택한 작업의 진행과 가능한 동작을 확인합니다." class="jobs-support wrap" />
                    <ui:VisualElement class="row jobs-actions">
                        <ui:Button name="selected-job-start" text="작업 실행" class="btn btn--accent" />
                        <ui:Button name="selected-job-cancel" text="대기 작업 취소" class="btn" />
                        <ui:VisualElement class="spacer" />
                        <ui:Button name="selected-job-monitor" text="운전 현황" class="btn" />
                        <ui:Button name="selected-job-inspect" text="검사 기록" class="btn" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="panel" style="position:absolute; left:1254px; top:164px; width:642px; height:868px;">
            <ui:VisualElement class="panel__spine" />
            <ui:VisualElement class="panel__head">
                <ui:Label text="신규 작업 등록" class="panel__title" />
                <ui:VisualElement class="spacer" />
                <ui:Label text="등록 후 실행 대기" class="panel__badge" />
            </ui:VisualElement>
            <ui:VisualElement class="panel__body">
                <ui:ScrollView mode="Vertical" class="jobs-register-scroll">
                    <ui:Label name="product-name" text="—" class="value value--lg wrap" />
                    <ui:Label name="product-meta" text="—" class="muted" style="margin-top:5px;" />

                    <ui:VisualElement class="sect" style="margin-top:14px;">
                        <ui:VisualElement class="sect__tick" />
                        <ui:Label text="조립체" class="sect__title" />
                        <ui:VisualElement class="spacer" />
                        <ui:Label name="preview-source" text="—" class="sect__unit" />
                    </ui:VisualElement>
                    <ui:VisualElement style="height:178px; background-color:rgb(20,28,36); margin-bottom:14px;">
                        <ui:Image name="product-preview" style="position:absolute; left:0; top:0; right:0; bottom:0;" />
                        <ui:VisualElement name="product-preview-empty" class="empty">
                            <ui:Label text="미리보기 없음" class="empty__title empty__title--miss" />
                            <ui:Label name="product-preview-desc" text="조립체 미리보기가 연결되지 않았습니다." class="empty__desc" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement class="sect">
                        <ui:VisualElement class="sect__tick" />
                        <ui:Label text="필요 부품" class="sect__title" />
                        <ui:VisualElement class="spacer" />
                        <ui:Label name="product-slot-count" text="—" class="sect__unit" />
                    </ui:VisualElement>
                    <ui:VisualElement name="slot-list" class="row vlist" style="flex-wrap:wrap; margin-bottom:10px;" />

                    <ui:VisualElement class="rule" style="margin-bottom:14px;" />
                    <ui:VisualElement class="row" style="height:46px;">
                        <ui:VisualElement style="width:230px;">
                            <ui:Label text="레시피" class="micro" />
                            <ui:Label name="recipe-version" text="assembly-r1" class="value" style="margin-top:4px;" />
                        </ui:VisualElement>
                        <ui:VisualElement>
                            <ui:Label text="목표 PASS 수량" class="micro" />
                            <ui:Label name="qty-value" text="1" class="value value--lg" style="margin-top:4px;" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement class="sect" style="margin-top:12px;">
                        <ui:VisualElement class="sect__tick" />
                        <ui:Label text="등록 전 확인" class="sect__title" />
                        <ui:VisualElement class="spacer" />
                        <ui:Label text="모두 충족해야 등록" class="sect__unit" />
                    </ui:VisualElement>
                    <ui:VisualElement name="interlock-list" class="vlist" />
                </ui:ScrollView>
                <ui:VisualElement class="spacer" />
                <ui:Button name="start-button" text="작업 등록" class="btn btn--accent" style="height:62px; font-size:20px;" />
                <ui:Label name="start-reason" text="" class="muted wrap" style="margin-top:8px; -unity-text-align:middle-center;" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:Instance template="FR5Shell" name="shell" class="shell-host" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
