<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Style src="project://database/Assets/UI/FR5Theme.uss" />
    <ui:Template src="project://database/Assets/UI/FR5Shell.uxml" name="FR5Shell" />

    <ui:VisualElement name="fr5-request" class="page fr5--mock">
        <ui:VisualElement class="page-heading">
            <ui:Label text="JOBS" class="page-heading__title" />
            <ui:Label text="/" class="page-heading__divider" />
            <ui:Label text="작업 현황" class="page-heading__title" />
            <ui:VisualElement class="spacer" />
            <ui:Label text="영속 요청 큐 · 최근 생산 이력" class="page-heading__meta" />
        </ui:VisualElement>

        <ui:VisualElement class="panel" style="position:absolute; left:112px; top:164px; width:1118px; height:868px;">
            <ui:VisualElement class="panel__spine" />
            <ui:VisualElement class="panel__head">
                <ui:Label text="JOB QUEUE · RECENT" class="panel__title" />
                <ui:Label name="job-count" text="—" class="panel__badge" style="margin-left:14px;" />
                <ui:VisualElement class="spacer" />
                <ui:Button name="job-refresh" text="새로고침" class="btn" style="width:112px; height:34px;" />
            </ui:VisualElement>
            <ui:VisualElement class="panel__body">
                <ui:VisualElement class="row" style="margin-bottom:14px;">
                    <ui:Button name="filter-all" text="ALL" class="btn job-filter job-filter--on" />
                    <ui:Button name="filter-queue" text="QUEUE" class="btn job-filter" />
                    <ui:Button name="filter-attention" text="ATTENTION" class="btn job-filter" />
                    <ui:Button name="filter-done" text="DONE" class="btn job-filter" />
                    <ui:VisualElement class="spacer" />
                    <ui:Label name="job-error" text="" class="bad" />
                </ui:VisualElement>

                <ui:VisualElement class="trow trow--head">
                    <ui:Label text="STATUS" class="tcell tcell--head" style="width:104px;" />
                    <ui:Label text="JOB" class="tcell tcell--head" style="width:150px;" />
                    <ui:Label text="PRODUCT" class="tcell tcell--head" style="width:260px;" />
                    <ui:Label text="PASS / TARGET" class="tcell tcell--head tcell--num" style="width:112px;" />
                    <ui:Label text="RESULT" class="tcell tcell--head" style="width:148px;" />
                    <ui:Label text="REQUESTED" class="tcell tcell--head" style="width:126px;" />
                    <ui:Label text="LINK" class="tcell tcell--head" style="width:132px;" />
                </ui:VisualElement>
                <ui:ScrollView mode="Vertical" style="flex-grow:1;">
                    <ui:VisualElement name="job-list" class="vlist" />
                </ui:ScrollView>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="panel" style="position:absolute; left:1254px; top:164px; width:642px; height:868px;">
            <ui:VisualElement class="panel__spine" />
            <ui:VisualElement class="panel__head">
                <ui:Label text="NEW JOB" class="panel__title" />
                <ui:VisualElement class="spacer" />
                <ui:Label text="production.jobs" class="panel__badge" />
            </ui:VisualElement>
            <ui:VisualElement class="panel__body">
                <ui:Label name="product-name" text="—" class="value value--lg wrap" />
                <ui:Label name="product-meta" text="—" class="muted" style="margin-top:5px;" />

                <ui:VisualElement class="sect" style="margin-top:14px;">
                    <ui:VisualElement class="sect__tick" />
                    <ui:Label text="조립체" class="sect__title" />
                    <ui:VisualElement class="spacer" />
                    <ui:Label name="preview-source" text="—" class="sect__unit" />
                </ui:VisualElement>
                <ui:VisualElement style="height:178px; background-color:rgb(20,28,36); margin-bottom:14px;">
                    <ui:Image name="product-preview" style="position:absolute; left:0; top:0; right:0; bottom:0;" />
                    <ui:VisualElement name="product-preview-empty" class="empty">
                        <ui:Label text="연결 없음" class="empty__title empty__title--miss" />
                        <ui:Label name="product-preview-desc" text="기판 미리보기 카메라 미지정" class="empty__desc" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="sect">
                    <ui:VisualElement class="sect__tick" />
                    <ui:Label text="필요 부품" class="sect__title" />
                    <ui:VisualElement class="spacer" />
                    <ui:Label name="product-slot-count" text="—" class="sect__unit" />
                </ui:VisualElement>
                <ui:VisualElement name="slot-list" class="row vlist" style="flex-wrap:wrap; margin-bottom:10px;" />

                <ui:VisualElement class="rule" style="margin-bottom:14px;" />
                <ui:VisualElement class="row" style="height:46px;">
                    <ui:VisualElement style="width:230px;">
                        <ui:Label text="RECIPE" class="micro" />
                        <ui:Label name="recipe-version" text="assembly-r1" class="value" style="margin-top:4px;" />
                    </ui:VisualElement>
                    <ui:VisualElement>
                        <ui:Label text="TARGET PASS" class="micro" />
                        <ui:Label name="qty-value" text="1" class="value value--lg" style="margin-top:4px;" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="sect" style="margin-top:12px;">
                    <ui:VisualElement class="sect__tick" />
                    <ui:Label text="등록 전 확인" class="sect__title" />
                    <ui:VisualElement class="spacer" />
                    <ui:Label text="모두 충족해야 등록" class="sect__unit" />
                </ui:VisualElement>
                <ui:VisualElement name="interlock-list" class="vlist" />
                <ui:VisualElement class="spacer" />
                <ui:Button name="start-button" text="REGISTER JOB" class="btn btn--accent" style="height:62px; font-size:20px; letter-spacing:4px;" />
                <ui:Label name="start-reason" text="" class="muted wrap" style="margin-top:8px; -unity-text-align:middle-center;" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:Instance template="FR5Shell" name="shell" class="shell-host" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
