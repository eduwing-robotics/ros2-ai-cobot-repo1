<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Style src="project://database/Assets/UI/FR5Theme.uss" />
    <ui:Template src="project://database/Assets/UI/FR5Shell.uxml" name="FR5Shell" />
    <!--
      INSPECT · 검사 판정 — docs/ui_recommendation/mockups-monitor-aligned/02_inspect-v2.png
      카메라 증거와 MainServer의 유닛 판정·불량·이력을 읽기 전용으로 보여 준다.
    -->
    <ui:VisualElement name="fr5-inspect" class="page page--dim fr5--mock">

        <ui:VisualElement class="page-heading">
            <ui:Label text="INSPECT" class="page-heading__title" />
            <ui:Label text="/" class="page-heading__divider" />
            <ui:Label text="검사" class="page-heading__title" />
            <ui:VisualElement class="spacer" />
            <ui:Label text="카메라 증거 · 판정 기록 · 읽기 전용" class="page-heading__meta" />
        </ui:VisualElement>

        <!-- 카메라 : 테두리 없이 영상 그 자체 -->
        <ui:VisualElement name="camera-panel" class="panel" style="position:absolute; left:112px; top:164px; width:1050px; height:744px;">
            <ui:VisualElement class="panel__spine" />
            <ui:VisualElement class="panel__head">
                <ui:Label text="INSPECTION CAMERA" class="panel__title" />
                <ui:VisualElement class="spacer" />
                <ui:Label text="/vision/board/image/compressed" class="panel__badge" />
            </ui:VisualElement>
            <ui:VisualElement style="flex-grow:1; padding:16px;">
                <ui:VisualElement name="camera-frame" style="flex-grow:1; background-color:rgb(20,28,36);">
                    <!-- CamVisionReceiver 가 이 Image 의 texture 를 채운다 (targetImage 로 지정) -->
                    <ui:Image name="camera-image" style="position:absolute; left:0; top:0; right:0; bottom:0;" />
                    <ui:VisualElement name="camera-empty" class="empty">
                        <ui:Label text="영상 없음" class="empty__title" />
                        <ui:Label name="camera-empty-desc" text="/vision/board/image 수신 대기" class="empty__desc" />
                    </ui:VisualElement>
                    <!-- TODO(API): 검출 박스는 /vision/board/capture/* 로 좌표를 받아 동적 생성 -->
                    <ui:VisualElement name="detect-box" style="position:absolute; left:220px; top:180px; width:300px; height:180px; border-width:2px; border-color:rgba(250,204,51,0.9); display:none;">
                        <ui:Label name="detect-label" text="BOARD 98.4%" class="accent" style="position:absolute; top:-22px; font-size:12px;" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="row" style="margin-top:12px;">
                    <ui:Label name="camera-stats" text="—" class="muted" style="font-size:12px;" />
                    <ui:VisualElement class="spacer" />
                    <ui:Label text="inspection_image_path 로 저장됨" class="muted" style="font-size:12px;" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 판정 -->
        <ui:VisualElement name="verdict-panel" class="panel" style="position:absolute; left:1186px; top:164px; width:710px; height:368px;">
            <ui:VisualElement class="panel__spine" />
            <ui:VisualElement class="panel__head">
                <ui:Label name="verdict-title" text="INSPECTION RESULT" class="panel__title" />
                <ui:VisualElement class="spacer" />
                <ui:Label text="영속 · DB 기록" class="panel__badge" style="color:rgb(62,207,142);" />
            </ui:VisualElement>
            <ui:VisualElement class="panel__body">
                <ui:VisualElement class="row">
                    <ui:Label name="verdict-value" text="—" style="font-size:70px; letter-spacing:-3px;" />
                    <ui:VisualElement class="spacer" />
                    <ui:VisualElement style="align-items:flex-end;">
                        <ui:Label name="verdict-score" text="—" class="value value--lg" />
                        <ui:Label text="검사 시각" class="muted" style="font-size:12px;" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="rule" style="margin-top:8px; margin-bottom:8px;" />
                <ui:VisualElement name="check-list" class="vlist" style="flex-grow:1;" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 불량 슬롯 -->
        <ui:VisualElement name="defect-panel" class="panel" style="position:absolute; left:1186px; top:556px; width:710px; height:352px;">
            <ui:VisualElement class="panel__spine" />
            <ui:VisualElement class="panel__head">
                <ui:Label text="DEFECT MAP · unit_defects" class="panel__title" />
                <ui:VisualElement class="spacer" />
                <ui:Label text="불량 슬롯만 기록된다" class="panel__badge" />
            </ui:VisualElement>
            <ui:VisualElement class="panel__body">
                <!-- TODO(API): unit_defects 조회로 채운다. 정상 슬롯은 행을 만들지 않는다 -->
                <ui:VisualElement name="defect-grid" class="row vlist" style="flex-wrap:wrap;" />
                <ui:VisualElement class="spacer" />
                <ui:VisualElement class="rule" style="margin-bottom:12px;" />
                <ui:Label name="defect-sql" text="unit_defects(unit_id=—, slot_code=—, defect_type=—)" class="muted mono" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 유닛 스트립 -->
        <ui:VisualElement name="units-panel" class="panel" style="position:absolute; left:112px; top:932px; width:1784px; height:124px;">
            <ui:VisualElement class="panel__spine" />
            <ui:VisualElement class="panel__head">
                <ui:Label text="JOB UNITS" class="panel__title" />
                <ui:VisualElement class="spacer" />
                <ui:Label name="units-summary" text="—" class="panel__badge" />
            </ui:VisualElement>
            <!-- jobs/{job_id}/units 조회 결과를 현재 계약대로 읽기 전용 표시한다. -->
            <ui:VisualElement name="unit-strip" class="row vlist" style="flex-grow:1; padding-left:18px; padding-right:18px;" />
        </ui:VisualElement>

        <!--
          공통 셸: 상단 바 + 페이지 레일 + 알람 띠.
          맨 마지막에 둔다 — 알람 띠가 페이지 패널 위로 그려져야 하기 때문이다.
        -->
        <ui:Instance template="FR5Shell" name="shell" class="shell-host" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
