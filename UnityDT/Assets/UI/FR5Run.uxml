<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Style src="project://database/Assets/UI/FR5Theme.uss" />
    <ui:Template src="project://database/Assets/UI/FR5Shell.uxml" name="FR5Shell" />
    <!--
      MONITOR · 운전 감시

      이 화면이 답하는 질문 (Docs/ui-design.md 2절)
        지금 이 셀이 안전한가 · 살아 있나 · 어디까지 갔나.
      이 셋에 답하지 않는 것은 여기 있지 않는다.

      두 갈래로 나눈다.
        왼쪽  로봇이 스스로 보고한 값에서 파생된 계기, 그리고 그 보고와 무관한
              유일한 증거인 카메라.
        가운데·오른쪽  트윈. 아무것도 그 위를 덮지 않는다.

      좌표
        진행 레일   x   88 .. 1920   y   64 ..   68
        좌 계기 열  x   88 ..  500   y   68 .. 내용 높이
        카메라      x   88 ..  500   y  772 .. 1080   (412 x 308, 4:3)
        지금 띠     x  500 .. 1920   y   68 ..  164
        트윈        x  500 .. 1920   y  164 ..  940
        슬롯 맵     x  500 .. 1920   y  940 .. 1080

      실데이터: 모드 · 로봇상태 · 워치독 · 관절 6축 · 그리퍼 · 조립 진행 ·
                슬롯/부품 · 레시피 버전 · 요청 ID
                TCP · RPY · 안전(E-STOP · 알람 · 이상정지 · 오류코드)은 Real 전용
      뺀 것: 작업(jobs) · 수량 · 사이클 · 속도 · 이벤트 로그 · 툴 오프셋
             전부 조회나 지령 경로가 없다. 없는 값이 자리를 차지하면 있는 값이 작아진다.
    -->
    <ui:VisualElement name="fr5-run" class="page page--run fr5--mock">

        <!--
          진행 레일. 화면에서 단조 증가하는 유일한 값이라 유일하게 크게 움직인다.
          조립 진행(놓인 슬롯 / 전체 슬롯)이다.
        -->
        <ui:VisualElement name="run-rail" class="run-rail">
            <ui:VisualElement name="run-progress-fill" class="run-rail__fill" />
        </ui:VisualElement>

        <!-- ==================== 좌 · 로봇 계기 ==================== -->
        <ui:VisualElement name="robot-panel" class="run-edge run-edge--left">

            <ui:VisualElement class="run-sect">
                <ui:Label text="JOINTS" class="run-sect__title" />
                <ui:VisualElement class="spacer" />
                <ui:Label text="deg · 리미트 대비" class="run-sect__unit" />
            </ui:VisualElement>
            <ui:VisualElement name="joint-list" class="vlist" />

            <ui:VisualElement class="run-hr" style="margin-top:10px; margin-bottom:10px;" />

            <ui:VisualElement class="run-sect">
                <ui:Label text="GRIPPER" class="run-sect__title" />
                <ui:VisualElement class="spacer" />
                <ui:Label text="mm · 최근 30초" class="run-sect__unit" />
            </ui:VisualElement>
            <ui:VisualElement class="row">
                <ui:VisualElement name="gripper-state-chip" class="chip"><ui:Label name="gripper-state-text" text="—" class="chip__text" /></ui:VisualElement>
                <ui:VisualElement class="spacer" />
                <ui:Label name="gripper-value" text="—" class="run-val" />
            </ui:VisualElement>
            <ui:VisualElement name="gripper-spark" class="spark" style="margin-top:6px;" />

            <!--
              TCP · RPY 는 /nonrt_state_data 로만 온다. Mock 은 채우지 않으므로
              블록째 접는다. 0 을 실측으로 오인하는 것보다 없는 편이 낫다.
            -->
            <ui:VisualElement name="pose-block" class="vlist">
                <ui:VisualElement class="run-hr" style="margin-top:10px; margin-bottom:10px;" />
                <ui:VisualElement class="run-sect">
                    <ui:Label text="TCP · RPY" class="run-sect__title" />
                    <ui:VisualElement class="spacer" />
                    <ui:Label text="mm · deg · base" class="run-sect__unit" />
                </ui:VisualElement>
                <ui:VisualElement name="tcp-row" class="vlist" />
            </ui:VisualElement>

            <!--
              안전. 조치가 필요한 유일한 종류의 정보다.
              E-STOP · 알람 · 이상정지 · 오류코드를 RobotStatusFrame 에서 직접 읽는다.
              이상일 때는 셸의 알람 띠가 화면 위쪽에서 따로 말한다. 여기는 상시 표시다.
            -->
            <ui:VisualElement name="safety-block" class="vlist">
                <ui:VisualElement class="run-hr" style="margin-top:10px; margin-bottom:10px;" />
                <ui:VisualElement class="run-sect">
                    <ui:Label text="SAFETY" class="run-sect__title" />
                    <ui:VisualElement class="spacer" />
                    <ui:Label name="real-source" text="—" class="run-sect__unit" />
                </ui:VisualElement>
                <ui:VisualElement name="real-status" class="vlist" />
            </ui:VisualElement>

            <!-- 접은 자리에 빈칸을 남기지 않고, 왜 없는지를 한 줄로 답한다. -->
            <ui:Label name="mock-note" text="TCP · RPY · SAFETY — Real 연결에서만 들어온다" class="run-sub" style="margin-top:14px;" />

            <ui:VisualElement class="run-hr" style="margin-top:10px; margin-bottom:10px;" />
            <ui:VisualElement class="row">
                <ui:VisualElement name="watchdog-dot" class="dot" />
                <ui:Label text="WATCHDOG" class="run-sect__title" style="margin-left:10px;" />
                <ui:VisualElement class="spacer" />
                <ui:Label name="watchdog-value" text="—" class="run-sub" />
            </ui:VisualElement>
            <ui:VisualElement name="watchdog-spark" class="spark" style="margin-top:4px;" />

        </ui:VisualElement>

        <!-- ==================== 좌하 · 카메라 ====================
          화면의 거의 모든 것은 로봇이 스스로 보고한 상태에서 파생된 값이다.
          카메라만이 그 보고와 무관한 증거다. 트윈이 "놓았다"고 할 때
          실제로 놓였는지는 이것만 답한다. 그래서 REAL 에서 값이 크고
          MOCK 에서는 같은 시뮬레이션을 다른 각도에서 본 것에 지나지 않는다.

          412 x 308 은 4:3 이다. 텍스처가 640x480 이고 ScaleToFit 이라
          이 비율에서만 레터박스가 0 이 된다.
        -->
        <ui:VisualElement name="cam-panel" class="run-cam-panel panel--aux">
            <ui:VisualElement name="cam-frame" class="run-cam">
                <ui:Image name="cam-image" style="position:absolute; left:0; top:0; right:0; bottom:0;" />
                <ui:VisualElement name="cam-empty" class="empty">
                    <ui:Label text="영상 없음" class="empty__title" style="font-size:14px;" />
                    <ui:Label name="cam-empty-desc" text="—" class="empty__desc" />
                </ui:VisualElement>
                <ui:VisualElement class="run-cam__bar">
                    <ui:Button name="cam-source-robot" class="chip chip--accent"><ui:Label text="ROBOT" class="chip__text" /></ui:Button>
                    <ui:Button name="cam-source-board" class="chip" style="margin-left:6px;"><ui:Label text="BOARD" class="chip__text" /></ui:Button>
                    <ui:VisualElement class="spacer" />
                    <!-- 트윈과 자리를 바꾼다. REAL 에서 실제로 놓였는지 크게 봐야 할 때 쓴다. -->
                    <ui:Button name="cam-expand" class="chip"><ui:Label text="확대" class="chip__text" /></ui:Button>
                </ui:VisualElement>
                <ui:Label name="cam-badge" text="—" class="run-cam__tag" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ==================== 지금 ====================
          "지금 무엇을, 어디에" 하나로 답하는 자리다. 트윈 바로 위에 두어
          3D 를 보는 시선과 같은 시야에 들어오게 한다.

          슬롯 코드가 화면에서 가장 큰 글자다. 실패했을 때 사람이 갈 좌표이고,
          DB · 레시피 · 검사가 모두 같은 값을 쓴다 (Docs/Recipe.md).
        -->
        <ui:VisualElement name="now-band" class="run-now">
            <ui:VisualElement style="flex-grow:1;">
                <ui:Label name="unit-phase" text="—" class="run-now__phase" />
                <ui:VisualElement class="row" style="margin-top:2px;">
                    <ui:Label name="now-slot" text="—" class="run-now__slot" />
                    <ui:Label name="now-part" text="" class="run-now__part" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement style="align-items:flex-end;">
                <ui:Label name="progress-count" text="—" class="run-now__count" />
                <ui:Label name="unit-step" text="—" class="run-sub" style="margin-top:4px;" />
                <!--
                  레시피 버전과 요청 ID. 스텝 수가 기판 슬롯 수와 어긋났을 때
                  어느 레시피였는지 되짚을 수 있는 유일한 값이라 스텝 옆에 둔다.
                -->
                <ui:Label name="recipe-version" text="—" class="run-sect__unit" style="margin-top:6px;" />
                <ui:Label name="request-id" text="—" class="run-sect__unit" style="margin-top:2px;" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ==================== 하단 · 슬롯 맵 ====================
          숫자 진행률은 "얼마나"만 답한다. "어디가 비었나"는 기판 배치와
          대응하는 맵만 답한다. 부품 타입 하나가 묶음 하나, 칸 하나가 슬롯 하나다.
          칸 수와 순서는 씬의 기판(ItemManager)이, 어디까지 놓였는지는
          조립 피드백(AssemblyProgressManager)이 답한다. 샘플 상수가 없다.
        -->
        <ui:VisualElement name="progress-panel" class="run-deck panel--aux">
            <ui:VisualElement class="run-sect" style="margin-bottom:10px;">
                <ui:Label text="SLOT MAP" class="run-sect__title" />
                <ui:VisualElement class="spacer" />
                <ui:Label name="progress-now" text="—" class="run-sub" />
            </ui:VisualElement>
            <ui:VisualElement name="progress-groups" class="row vlist" style="flex-grow:1;" />
        </ui:VisualElement>

        <!--
          공통 셸: 상단 바 + 페이지 레일 + 알람 띠.
          맨 마지막에 둔다. 알람 띠가 페이지 요소 위로 그려져야 하기 때문이다.
        -->
        <ui:Instance template="FR5Shell" name="shell" class="shell-host" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
