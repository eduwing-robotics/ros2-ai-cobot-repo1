<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Style src="project://database/Assets/UI/FR5Theme.uss" />
    <ui:Template src="project://database/Assets/UI/FR5Shell.uxml" name="FR5Shell" />
    <!--
      RUN · 작업 실행 중

      구성 원칙 (Docs/ui-design.md 2절)
        1. 트윈은 구멍이 아니라 지면이다. 계기는 트윈 위에 뜬 상자가 아니라
           화면 양 가장자리에 얹힌 층이다. 그래서 상자 테두리 · 헤더 · 척추를
           쓰지 않는다. 경계는 스크림의 밝기 차이 하나로만 만든다.
        2. 크게 움직이는 것은 하나뿐이다. 상단을 가로지르는 진행 레일이다.
           나머지는 값이 바뀌어도 자리가 움직이지 않는다.
        3. 좌우가 대칭이 아니다. 왼쪽 412 는 항상 보는 것(로봇), 오른쪽 360 은
           필요할 때 보는 것(영상 · 작업 · 이벤트)이라 TWIN 으로 접힌다.

      좌표
        진행 레일   x   88 .. 1920   y   64 ..   68
        좌 계기 열  x   88 ..  500   y   68 .. 1080
        트윈        x  500 .. 1560   y   68 .. 1080   (아래 120 은 진행 데크가 덮음)
        우 열       x 1560 .. 1920   y   68 .. 1080
        진행 데크   x  500 .. 1560   y  960 .. 1080

      실데이터: 관절 · TCP · RPY · 그리퍼 · 워치독 · 모드 · 링크 · 조립 진행
      TCP · RPY · SAFETY 는 Real 전용이라 Mock 에서는 접는다.
      샘플데이터: 작업 · 유닛 · 이벤트  [TODO(API)]
    -->
    <ui:VisualElement name="fr5-run" class="page page--run fr5--mock">

        <!--
          진행 레일. 화면에서 단조 증가하는 유일한 값이라 유일하게 크게 움직인다.
          조립 진행(놓인 슬롯 / 전체 슬롯)이다. 아직 연결되지 않은 jobs 진행이
          아니므로 상단 바의 JOB 게이지와 같은 값이 아니다.
        -->
        <ui:VisualElement name="run-rail" class="run-rail">
            <ui:VisualElement name="run-progress-fill" class="run-rail__fill" />
        </ui:VisualElement>

        <!-- ==================== 좌 · 로봇 계기 ==================== -->
        <!--
          항상 보는 것이다. TWIN 으로 접지 않는다 — 로봇 상태가 사라지면
          트윈을 보는 이유 자체가 사라진다.
        -->
        <ui:VisualElement name="robot-panel" class="run-edge run-edge--left">

            <!--
              POSE. TCP 와 RPY 는 같은 포즈의 두 축이라 제목 하나를 나눠 쓴다.
              Mock Backend 는 두 값을 채우지 않으므로 Mock 에서는 블록째 접는다.
            -->
            <ui:VisualElement name="pose-block" class="vlist">
                <ui:VisualElement class="run-sect">
                    <ui:Label text="TCP · RPY" class="run-sect__title" />
                    <ui:VisualElement class="spacer" />
                    <ui:Label text="mm · deg · base" class="run-sect__unit" />
                </ui:VisualElement>
                <ui:VisualElement name="tcp-row" class="row vlist" style="margin-bottom:14px;" />
                <ui:VisualElement name="rpy-row" class="row vlist" />
                <ui:VisualElement class="row" style="margin-top:14px;">
                    <ui:Label text="Z 높이" class="run-sect__unit" />
                    <ui:VisualElement class="spacer" />
                    <ui:Label text="최근 30초" class="run-sect__unit" />
                </ui:VisualElement>
                <ui:VisualElement name="tcp-spark" class="spark" style="margin-top:4px;" />
                <ui:VisualElement class="run-hr" style="margin-top:20px;" />
            </ui:VisualElement>

            <ui:VisualElement class="run-sect" style="margin-top:20px;">
                <ui:Label text="JOINTS" class="run-sect__title" />
                <ui:VisualElement class="spacer" />
                <ui:Label text="deg · 리미트 대비" class="run-sect__unit" />
            </ui:VisualElement>
            <ui:VisualElement name="joint-list" class="vlist" />

            <ui:VisualElement class="run-hr" style="margin-top:20px; margin-bottom:20px;" />

            <ui:VisualElement class="run-sect">
                <ui:Label text="GRIPPER" class="run-sect__title" />
                <ui:VisualElement class="spacer" />
                <ui:Label text="mm · 최근 30초" class="run-sect__unit" />
            </ui:VisualElement>
            <ui:VisualElement class="row">
                <ui:VisualElement name="gripper-state-chip" class="chip"><ui:Label name="gripper-state-text" text="—" class="chip__text" /></ui:VisualElement>
                <ui:VisualElement class="spacer" />
                <ui:Label name="gripper-value" text="—" class="run-val" style="font-size:28px;" />
            </ui:VisualElement>
            <ui:VisualElement class="gauge" style="margin-top:12px;">
                <ui:VisualElement name="gripper-fill" class="gauge__fill" />
            </ui:VisualElement>
            <ui:VisualElement name="gripper-spark" class="spark" style="margin-top:10px;" />

            <!-- /nonrt_state_data 로만 오는 값들. Mock 은 채우지 않으므로 접는다. -->
            <ui:VisualElement name="safety-block" class="vlist">
                <ui:VisualElement class="run-hr" style="margin-top:20px; margin-bottom:20px;" />
                <ui:VisualElement class="run-sect">
                    <ui:Label text="SAFETY · REAL" class="run-sect__title" />
                    <ui:VisualElement class="spacer" />
                    <ui:Label name="real-source" text="—" class="run-sect__unit" />
                </ui:VisualElement>
                <ui:VisualElement name="real-status" class="vlist" />
            </ui:VisualElement>

            <!-- 접은 자리에 빈칸을 남기지 않고, 왜 없는지를 한 줄로 답한다. -->
            <ui:Label name="mock-note" text="TCP · RPY · SAFETY — Real 연결에서만 들어온다" class="run-sub" style="margin-top:18px;" />

            <ui:VisualElement class="spacer" />
            <ui:VisualElement class="run-hr" style="margin-bottom:14px;" />
            <ui:VisualElement class="row">
                <ui:VisualElement name="watchdog-dot" class="dot" />
                <ui:Label text="WATCHDOG" class="run-sect__title" style="margin-left:10px;" />
                <ui:VisualElement class="spacer" />
                <ui:Label text="최근 30초" class="run-sect__unit" style="margin-right:10px;" />
                <ui:Label name="watchdog-value" text="—" class="run-sub" />
            </ui:VisualElement>
            <ui:VisualElement name="watchdog-spark" class="spark" style="margin-top:6px;" />
            <ui:Label name="tool-value" text="tool Z —" class="run-sub" style="margin-top:8px;" />
        </ui:VisualElement>

        <!-- ==================== 우 · 영상 · 작업 · 이벤트 ==================== -->
        <!--
          필요할 때 보는 것이라 TWIN 으로 통째로 접힌다. 접으면 트윈이
          x500 부터 화면 오른쪽 끝까지 이어진다.
          JOB 번호와 진행률은 상단 바에 정본이 있으므로 접혀도 잃는 것이 없다.
        -->
        <ui:VisualElement name="job-panel" class="run-edge run-edge--right panel--aux">

            <!--
              카메라. 360 폭에 4:3 이라 270 이다. 텍스처가 640x480 이고 Image 는
              ScaleToFit 이라 이 비율에서만 레터박스가 0 이 된다.
              테두리도 헤더도 주지 않는다 — 영상은 이미 자기 표면이다.
            -->
            <ui:VisualElement name="vision-panel" class="run-cam">
                <ui:VisualElement name="vision-frame" style="position:absolute; left:0; top:0; right:0; bottom:0;">
                    <ui:Image name="camera-image" style="position:absolute; left:0; top:0; right:0; bottom:0;" />
                    <ui:VisualElement name="vision-empty" class="empty">
                        <ui:Label text="영상 없음" class="empty__title" style="font-size:14px;" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label text="ROBOT CAM" class="run-cam__tag" />
            </ui:VisualElement>

            <ui:VisualElement class="row" style="padding-left:24px; padding-right:24px; height:34px;">
                <ui:Label name="vision-stats" text="—" class="run-sub" />
                <ui:VisualElement class="spacer" />
                <ui:Label text="INSPECT →" class="accent" style="font-size:11px;" />
            </ui:VisualElement>

            <ui:VisualElement style="flex-grow:1; padding-left:24px; padding-right:24px; padding-bottom:20px;">

                <ui:VisualElement class="run-hr" style="margin-bottom:18px;" />
                <ui:VisualElement class="run-sect">
                    <ui:Label text="ASSEMBLY JOB" class="run-sect__title" />
                    <ui:VisualElement class="spacer" />
                    <ui:Label text="영속 · DB" class="run-sect__unit" />
                </ui:VisualElement>
                <!-- TODO(API): jobs · units 조회로 교체 -->
                <ui:Label name="job-product" text="—" class="run-val" />
                <ui:Label name="job-recipe" text="—" class="run-sub" style="margin-top:4px;" />

                <ui:VisualElement class="run-hr" style="margin-top:18px; margin-bottom:18px;" />
                <ui:VisualElement class="run-sect">
                    <ui:Label text="CURRENT UNIT" class="run-sect__title" />
                    <ui:VisualElement class="spacer" />
                    <ui:Label text="unit_phase" class="run-sect__unit" />
                </ui:VisualElement>
                <!-- 이 화면에서 가장 큰 글자다. "지금 무슨 단계인가"가 RUN 의 질문이다. -->
                <ui:Label name="unit-phase" text="—" class="run-lead" />
                <ui:Label name="unit-step" text="—" class="run-sub vlist" style="margin-top:6px;" />

                <ui:VisualElement class="run-hr" style="margin-top:18px; margin-bottom:18px;" />
                <ui:VisualElement class="run-sect">
                    <ui:Label text="EVENTS" class="run-sect__title" />
                    <ui:VisualElement class="spacer" />
                    <ui:Label name="events-summary" text="—" class="run-sect__unit" />
                </ui:VisualElement>
                <ui:VisualElement name="event-list" class="vlist" />

                <ui:VisualElement class="spacer" />

                <!--
                  제어는 열 맨 아래에 둔다. 터치 패널에서 손이 가장 먼저 닿는 자리다.
                  셋 다 계약이 없어 비활성이고, 그 사실은 아래 한 줄이 적는다.
                -->
                <ui:VisualElement class="row">
                    <ui:Button name="job-pause-button" text="PAUSE" class="btn" style="width:96px;" />
                    <ui:Button name="job-step-button" text="STEP" class="btn" style="width:96px; margin-left:12px;" />
                    <ui:Button name="job-abort-button" text="ABORT" class="btn btn--danger" style="width:96px; margin-left:12px;" />
                </ui:VisualElement>
                <ui:Label name="abort-note" text="—" class="run-sub" style="font-size:11px; margin-top:6px; -unity-text-align:middle-right;" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ==================== 하단 · 조립 진행 ====================
          부품 타입 하나가 묶음 하나, 칸 하나가 슬롯 하나다. 스텝 레일이 아니다.
          레시피의 한 스텝은 "부품 하나를 슬롯 하나에 올리는 것"이고
          approach/insert/retract 는 그 스텝 안의 모션이다 (Docs/Recipe.md).

          트윈 위에 얹는다. 슬롯은 실제로 저 3D 안에 있는 것이라, 화면 아래
          가장자리에 붙여 두면 기판과 같은 방향에서 읽힌다.
        -->
        <ui:VisualElement name="progress-panel" class="run-deck panel--aux">
            <ui:VisualElement class="run-sect" style="margin-bottom:10px;">
                <ui:Label text="ASSEMBLY PROGRESS" class="run-sect__title" />
                <ui:VisualElement class="spacer" />
                <ui:Label name="progress-now" text="—" class="run-sub" />
                <ui:Label name="progress-count" text="—" class="run-val" style="margin-left:22px;" />
            </ui:VisualElement>
            <ui:VisualElement name="progress-groups" class="row vlist" style="flex-grow:1;" />
        </ui:VisualElement>

        <!--
          공통 셸: 상단 바 + 페이지 레일 + 알람 띠.
          맨 마지막에 둔다 — 알람 띠가 페이지 요소 위로 그려져야 하기 때문이다.
        -->
        <ui:Instance template="FR5Shell" name="shell" class="shell-host" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
