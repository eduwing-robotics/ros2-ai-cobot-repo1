<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Style src="project://database/Assets/UI/FR5Theme.uss" />
    <ui:Template src="project://database/Assets/UI/FR5Shell.uxml" name="FR5Shell" />
    <!--
      MONITOR · 이중 시야 (Docs/ui-design.md 2절)

      화면을 좌우로 나눈다.
        왼쪽  기준 — 트윈이 계산한 제자리. 로봇이 보고한 상태에서 파생된 그림이다.
        오른쪽 관측 — 카메라가 본 실제. 로봇의 자기 보고와 무관한 유일한 증거다.

      둘을 같은 크기로 나란히 두는 것이 이 배치의 전부다. 크기가 다르면 사람이
      한쪽을 먼저 보고, 그러면 비교가 아니라 확인이 된다.
      차이를 계산하려면 "제자리가 어디인가"를 알아야 하고 그 기준을 트윈이 준다.
      카메라만으로는 어긋났다는 사실 자체를 모른다.

      좌표
        진행 레일   x   88 .. 1920   y   64 ..   70
        기준(트윈)  x   88 ..  996   y   70 ..  810
        관측(카메라) x 1012 .. 1920   y   70 ..  810
        계기 띠     x   88 .. 1920   y  810 .. 1080

      실데이터: 모드 · 로봇상태 · 워치독 · 관절 6축 · 그리퍼 · 조립 진행 ·
                슬롯/부품 · 레시피 버전 · 요청 ID
                TCP · RPY · 안전은 Real 전용이라 Mock 에서는 접힌다.
    -->
    <ui:VisualElement name="fr5-run" class="page page--run fr5--mock">

        <!-- 진행 레일. 화면에서 크게 움직이는 유일한 것이다. -->
        <ui:VisualElement name="run-rail" class="run-rail">
            <ui:VisualElement name="run-progress-fill" class="run-rail__fill" />
        </ui:VisualElement>

        <!-- ==================== 좌 · 기준 (트윈) ====================
          여기는 비워 둔다. page 배경이 투명이라 3D 트윈이 그대로 보인다.
          이름표만 얹고 아무것도 덮지 않는다.
        -->
        <ui:VisualElement name="twin-pane" class="run-pane run-pane--twin" picking-mode="Ignore">
            <ui:Label text="기준 — 트윈이 계산한 제자리" class="run-pane__title" />
            <ui:Label name="twin-source" text="—" class="run-pane__source" />
        </ui:VisualElement>

        <!-- ==================== 우 · 관측 (카메라) ====================
          CCTV 분할. 켠 카메라 수에 따라 1 · 2 · 4 칸으로 나뉜다.
          칸마다 자기 수신기가 붙고, 자기 이름과 마지막 프레임 나이를 스스로 적는다.
          어느 칸이 늦는지 한 눈에 보여야 하므로 나이는 칸마다 따로 둔다.
        -->
        <ui:VisualElement name="cam-panel" class="run-pane run-pane--cam panel--aux">
            <ui:VisualElement name="cam-grid" class="run-cam-grid">
                <ui:VisualElement name="cam-tile-1" class="run-cam-tile">
                    <ui:Image name="cam-image-1" class="run-cam-tile__img" />
                    <ui:Label name="cam-title-1" text="TRAY" class="run-cam-tile__title" />
                    <ui:Label name="cam-age-1" text="—" class="run-cam-tile__age" />
                </ui:VisualElement>
                <ui:VisualElement name="cam-tile-2" class="run-cam-tile">
                    <ui:Image name="cam-image-2" class="run-cam-tile__img" />
                    <ui:Label name="cam-title-2" text="PARTS" class="run-cam-tile__title" />
                    <ui:Label name="cam-age-2" text="—" class="run-cam-tile__age" />
                </ui:VisualElement>
                <ui:VisualElement name="cam-tile-3" class="run-cam-tile">
                    <ui:Image name="cam-image-3" class="run-cam-tile__img" />
                    <ui:Label name="cam-title-3" text="CONVEYOR" class="run-cam-tile__title" />
                    <ui:Label name="cam-age-3" text="—" class="run-cam-tile__age" />
                </ui:VisualElement>
                <ui:VisualElement name="cam-tile-4" class="run-cam-tile">
                    <ui:Image name="cam-image-4" class="run-cam-tile__img" />
                    <ui:Label name="cam-title-4" text="CELL · RAW" class="run-cam-tile__title" />
                    <ui:Label name="cam-age-4" text="—" class="run-cam-tile__age" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!--
              패널 제목과 수신 배지를 아래 띠로 내린다. 칸마다 자기 이름과 나이를
              왼쪽 위·오른쪽 위에 적으므로, 패널 제목을 같은 자리에 두면 겹친다.
            -->
            <ui:VisualElement class="run-cam__bar">
                <ui:Label text="관측" class="run-cam__bar-title" />
                <ui:Button name="cam-chip-1" class="chip chip--accent" style="margin-left:12px;"><ui:Label text="TRAY" class="chip__text" /></ui:Button>
                <ui:Button name="cam-chip-2" class="chip" style="margin-left:6px;"><ui:Label text="PARTS" class="chip__text" /></ui:Button>
                <ui:Button name="cam-chip-3" class="chip" style="margin-left:6px;"><ui:Label text="CONVEYOR" class="chip__text" /></ui:Button>
                <ui:Button name="cam-chip-4" class="chip" style="margin-left:6px;"><ui:Label text="CELL" class="chip__text" /></ui:Button>
                <ui:VisualElement class="spacer" />
                <ui:Label name="cam-badge" text="—" class="run-cam__bar-badge" />
                <ui:Button name="cam-expand" class="chip"><ui:Label text="확대" class="chip__text" /></ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ==================== 하단 · 계기 띠 ====================
          좌우 두 그림이 같은 크기를 지키려면 계기가 가로로 내려와야 한다.
          열 다섯으로 나누고, Real 전용 열은 Mock 에서 접힌다.
        -->
        <ui:VisualElement name="progress-panel" class="run-deck panel--aux">

            <!-- 1. 지금 -->
            <ui:VisualElement class="run-col" style="left:32px; width:300px;">
                <ui:Label name="unit-phase" text="—" class="run-now__phase" />
                <ui:VisualElement class="row" style="margin-top:2px;">
                    <ui:Label name="now-slot" text="—" class="run-now__slot" />
                    <ui:Label name="now-part" text="" class="run-now__part" />
                </ui:VisualElement>
                <ui:Label name="unit-step" text="—" class="run-sub" style="margin-top:6px;" />
                <ui:VisualElement class="spacer" />
                <ui:Label name="recipe-version" text="—" class="run-sect__unit" />
                <ui:Label name="request-id" text="—" class="run-sect__unit" style="margin-top:2px;" />
            </ui:VisualElement>

            <!-- 2. 관절 -->
            <ui:VisualElement class="run-col run-col--rule" style="left:364px; width:290px;">
                <ui:VisualElement class="run-sect">
                    <ui:Label text="JOINTS" class="run-sect__title" />
                    <ui:VisualElement class="spacer" />
                    <ui:Label text="deg · 리미트 대비" class="run-sect__unit" />
                </ui:VisualElement>
                <ui:VisualElement name="joint-list" class="vlist" />
            </ui:VisualElement>

            <!-- 3. TCP · 안전 (Real 전용) -->
            <ui:VisualElement class="run-col run-col--rule" style="left:686px; width:290px;">
                <ui:VisualElement name="pose-block" class="vlist">
                    <ui:VisualElement class="run-sect">
                        <ui:Label text="TCP · RPY" class="run-sect__title" />
                        <ui:VisualElement class="spacer" />
                        <ui:Label text="mm · deg · base" class="run-sect__unit" />
                    </ui:VisualElement>
                    <ui:VisualElement name="tcp-row" class="vlist" />
                </ui:VisualElement>
                <ui:VisualElement name="safety-block" class="vlist" style="margin-top:12px;">
                    <ui:VisualElement class="run-sect">
                        <ui:Label text="SAFETY" class="run-sect__title" />
                        <ui:VisualElement class="spacer" />
                        <ui:Label name="real-source" text="—" class="run-sect__unit" />
                    </ui:VisualElement>
                    <ui:VisualElement name="real-status" class="vlist" />
                </ui:VisualElement>
                <ui:Label name="mock-note" text="TCP · RPY · SAFETY — Real 연결에서만 들어온다" class="run-sub" />
            </ui:VisualElement>

            <!-- 4. 그리퍼 · 워치독 -->
            <ui:VisualElement class="run-col run-col--rule" style="left:1008px; width:210px;">
                <ui:VisualElement class="run-sect">
                    <ui:Label text="GRIPPER" class="run-sect__title" />
                    <ui:VisualElement class="spacer" />
                    <ui:Label text="mm · 30초" class="run-sect__unit" />
                </ui:VisualElement>
                <ui:VisualElement class="row">
                    <ui:VisualElement name="gripper-state-chip" class="chip"><ui:Label name="gripper-state-text" text="—" class="chip__text" /></ui:VisualElement>
                    <ui:VisualElement class="spacer" />
                    <ui:Label name="gripper-value" text="—" class="run-val" />
                </ui:VisualElement>
                <ui:VisualElement name="gripper-spark" class="spark" style="margin-top:6px;" />
                <ui:VisualElement class="run-hr" style="margin-top:12px; margin-bottom:12px;" />
                <ui:VisualElement class="row">
                    <ui:VisualElement name="watchdog-dot" class="dot" />
                    <ui:Label text="WATCHDOG" class="run-sect__title" style="margin-left:10px;" />
                    <ui:VisualElement class="spacer" />
                    <ui:Label name="watchdog-value" text="—" class="run-sub" />
                </ui:VisualElement>
                <ui:VisualElement name="watchdog-spark" class="spark" style="margin-top:4px;" />
            </ui:VisualElement>

            <!-- 5. 슬롯 맵 -->
            <ui:VisualElement class="run-col run-col--rule" style="left:1250px; right:32px;">
                <ui:VisualElement class="run-sect">
                    <ui:Label text="SLOT MAP" class="run-sect__title" />
                    <ui:VisualElement class="spacer" />
                    <ui:Label name="progress-now" text="—" class="run-sub" />
                    <ui:Label name="progress-count" text="—" class="run-val" style="margin-left:16px;" />
                </ui:VisualElement>
                <ui:VisualElement name="progress-groups" class="row vlist" style="flex-grow:1; flex-wrap:wrap; align-items:flex-start;" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!--
          공통 셸: 상단 바 + 페이지 레일 + 알람 띠.
          맨 마지막에 둔다. 알람 띠가 페이지 요소 위로 그려져야 하기 때문이다.
        -->
        <ui:Instance template="FR5Shell" name="shell" class="shell-host" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
