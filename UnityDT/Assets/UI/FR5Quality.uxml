<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Style src="project://database/Assets/UI/FR5Theme.uss" />
    <ui:Template src="project://database/Assets/UI/FR5Shell.uxml" name="FR5Shell" />
    <!--
      QUALITY · 누적 불량률과 대책서 — docs/ui_recommendation/mockups-monitor-aligned/04_quality-v2.png
      조회 성격이라 실시간 갱신이 없다. 진입 시 1회 + 수동 새로고침.

      실데이터: MainServer의 현재 작업 → 제품 → 슬롯/부품별 품질 집계.
      레시피 비교와 대책서는 조회 계약이 생길 때까지 명시적 빈 상태로 남긴다.
    -->
    <ui:VisualElement name="fr5-quality" class="page page--dim fr5--mock">

        <ui:VisualElement class="page-heading">
            <ui:Label text="QUALITY" class="page-heading__title" />
            <ui:Label text="/" class="page-heading__divider" />
            <ui:Label text="품질" class="page-heading__title" />
            <ui:VisualElement class="spacer" />
            <ui:Label text="MAINSERVER · READ ONLY" class="page-heading__meta" />
        </ui:VisualElement>

        <!-- 조회 조건 -->
        <ui:VisualElement name="filter-panel" class="panel row" style="position:absolute; left:112px; top:164px; width:1784px; height:76px; padding-left:24px; padding-right:24px;">
            <ui:VisualElement class="panel__spine" />
            <!-- TODO(API): 기간·제품·레시피·유형 필터는 조회 API 파라미터로 넘긴다 -->
            <ui:VisualElement style="width:280px;"><ui:Label text="기간" class="micro" /><ui:Label name="filter-period" text="—" class="value" style="font-size:18px; margin-top:4px;" /></ui:VisualElement>
            <ui:VisualElement style="width:340px;"><ui:Label text="제품" class="micro" /><ui:Label name="filter-product" text="—" class="value" style="font-size:18px; margin-top:4px;" /></ui:VisualElement>
            <ui:VisualElement style="width:240px;"><ui:Label text="레시피" class="micro" /><ui:Label name="filter-recipe" text="—" class="value" style="font-size:18px; margin-top:4px;" /></ui:VisualElement>
            <ui:VisualElement style="width:240px;"><ui:Label text="불량 유형" class="micro" /><ui:Label name="filter-defect" text="—" class="value" style="font-size:18px; margin-top:4px;" /></ui:VisualElement>
            <ui:VisualElement class="spacer" />
            <ui:VisualElement name="source-chip" class="chip" style="margin-right:16px;">
                <ui:Label name="source-text" text="—" class="chip__text" />
            </ui:VisualElement>
            <ui:Button name="refresh-button" text="새로고침" class="btn" style="width:110px; height:44px; margin-right:20px;" />
            <ui:VisualElement style="align-items:flex-end;">
                <ui:Label name="filter-count" text="—" class="muted" style="font-size:12px;" />
                <ui:Label name="filter-note" text="조회 전용 · production 읽기" class="warn" style="font-size:12px; margin-top:4px;" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 슬롯별 불량률 -->
        <ui:VisualElement name="slot-panel" class="panel" style="position:absolute; left:112px; top:264px; width:940px; height:436px;">
            <ui:VisualElement class="panel__spine" />
            <ui:VisualElement class="panel__head">
                <ui:Label text="SLOT DEFECT RATE" class="panel__title" />
                <ui:VisualElement class="spacer" />
                <ui:Label name="slot-threshold" text="—" class="panel__badge" />
            </ui:VisualElement>
            <!-- TODO(API): production 집계. 슬롯별 누적 불량률 -->
            <ui:VisualElement name="slot-grid" class="row vlist" style="flex-wrap:wrap; padding:18px;" />
        </ui:VisualElement>

        <!-- 부품·유형별 -->
        <ui:VisualElement name="part-panel" class="panel" style="position:absolute; left:1076px; top:264px; width:820px; height:436px;">
            <ui:VisualElement class="panel__spine" />
            <ui:VisualElement class="panel__head">
                <ui:Label text="PART DEFECT RATE" class="panel__title" />
                <ui:VisualElement class="spacer" />
                <ui:Label text="부품 · 유형별" class="panel__badge" />
            </ui:VisualElement>
            <ui:VisualElement class="panel__body">
                <ui:VisualElement class="trow trow--head">
                    <ui:Label text="PART" class="tcell tcell--head" style="width:300px;" />
                    <ui:Label text="TYPE" class="tcell tcell--head" style="width:200px;" />
                    <ui:Label text="불량 / 검사" class="tcell tcell--head tcell--num" style="width:140px;" />
                    <ui:Label text="RATE" class="tcell tcell--head tcell--num" style="width:100px;" />
                </ui:VisualElement>
                <!-- TODO(API): defect_report.thresholds 와 대조해 임계 초과를 판정한다 -->
                <ui:VisualElement name="part-list" class="vlist" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 레시피 전후 -->
        <ui:VisualElement name="recipe-panel" class="panel" style="position:absolute; left:112px; top:724px; width:940px; height:256px;">
            <ui:VisualElement class="panel__spine" />
            <ui:VisualElement class="panel__head">
                <ui:Label text="RECIPE A / B" class="panel__title" />
                <ui:VisualElement class="spacer" />
                <ui:Label name="recipe-note" text="개선 전후 비교" class="panel__badge" />
            </ui:VisualElement>
            <!-- TODO(API): alert_countermeasures.applied_recipe_version 기준 전후 집계 -->
            <ui:VisualElement name="recipe-compare" class="row vlist" style="padding:18px;" />
        </ui:VisualElement>

        <!-- 대책서 -->
        <ui:VisualElement name="alert-panel" class="panel" style="position:absolute; left:1076px; top:724px; width:820px; height:256px;">
            <ui:VisualElement class="panel__spine" />
            <ui:VisualElement class="panel__head">
                <ui:Label text="DEFECT REPORT · alerts" class="panel__title" />
                <ui:VisualElement class="spacer" />
                <ui:Label name="alert-summary" text="—" class="panel__badge" />
            </ui:VisualElement>
            <!-- TODO(API): defect_report.alerts 조회 -->
            <ui:VisualElement name="alert-list" class="vlist" style="padding-left:18px; padding-right:18px;" />
        </ui:VisualElement>

        <!-- 출처 고지 -->
        <ui:VisualElement class="panel" style="position:absolute; left:112px; top:996px; right:24px; height:60px; padding:10px 18px 10px 18px;">
            <ui:Label text="출처: MainServer HTTP · production units / unit_defects" class="muted" style="font-size:12px;" />
            <ui:Label text="레시피 비교 · thresholds · alerts 는 조회 계약이 없어 빈 상태로 표시합니다." class="muted" style="font-size:12px; margin-top:4px; color:rgb(100,112,122);" />
        </ui:VisualElement>

        <!--
          공통 셸: 상단 바 + 페이지 레일 + 알람 띠.
          맨 마지막에 둔다 — 알람 띠가 페이지 패널 위로 그려져야 하기 때문이다.
        -->
        <ui:Instance template="FR5Shell" name="shell" class="shell-host" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
