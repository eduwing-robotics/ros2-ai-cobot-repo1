        <mxCell id="lg_relation" value="FK 열 행 ──&amp;lt; PK 열 행&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;점선 = NULL 허용 FK (ERzeroToOne)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#6E7B8B;" vertex="1" parent="1">
          <mxGeometry x="870" y="1000" width="420" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="divider" value="" style="line;strokeWidth=1;html=1;strokeColor=#DDE2E8;" vertex="1" parent="1">
          <mxGeometry x="320" y="1048" width="1480" height="10" as="geometry"/>
        </mxCell>
        <mxCell id="note_rules" value="&lt;b&gt;고유 제약&lt;/b&gt;&lt;br&gt;U1&amp;nbsp;&amp;nbsp;products (product_code, product_version)&lt;br&gt;U2&amp;nbsp;&amp;nbsp;product_slots (product_id, slot_code)&lt;br&gt;U3&amp;nbsp;&amp;nbsp;units (job_id, unit_sequence_in_job)&lt;br&gt;U4&amp;nbsp;&amp;nbsp;unit_defects (unit_id, product_slot_id)&lt;br&gt;U5&amp;nbsp;&amp;nbsp;inventory_movements (unit_id, part_id) WHERE movement_type = 'CONSUMPTION'&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;inventory_movements (part_id) WHERE movement_type = 'OPENING'&lt;br&gt;&lt;br&gt;&lt;b&gt;동시 실행 제한 (부분 유니크 인덱스)&lt;/b&gt;&lt;br&gt;jobs ((1)) WHERE job_status = 'RUNNING'&amp;nbsp; →&amp;nbsp; 전체에서 RUNNING Job 은 1건&lt;br&gt;units (job_id) WHERE unit_status = 'RUNNING'&amp;nbsp; →&amp;nbsp; Job 당 RUNNING Unit 은 1건&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#B85450&quot;&gt;완료 수량은 저장하지 않는다. COMPLETED 인 units 를 COUNT(*) 한다.&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#C9CFD8;strokeWidth=1.5;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;spacingLeft=16;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="320" y="1080" width="740" height="230" as="geometry"/>
        </mxCell>
        <mxCell id="note_scope" value="&lt;b&gt;스키마 경계&lt;/b&gt;&lt;br&gt;control 스키마와 assembly_requests 는 제거되었고 jobs 가 영속 요청 큐를 겸한다.&lt;br&gt;job_id 는 uuid 로, MainServer 가 발급한 값을 그대로 PK 로 쓴다.&lt;br&gt;&lt;br&gt;part_catalog · defect_report 는 DB 에 두지 않는다.&lt;br&gt;&amp;nbsp;&amp;nbsp;· 부품 데이터시트 →&amp;nbsp; MAIN_SERVER/data/*.xlsx (읽기 전용)&lt;br&gt;&amp;nbsp;&amp;nbsp;· 불량대책서 →&amp;nbsp; MAIN_SERVER/reports/defects/*.xlsx (자동 생성)&lt;br&gt;&lt;br&gt;로봇 레시피 본문은 DB 밖에 있고 jobs.recipe_version 이 실행 사실만 기록한다.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#999999&quot;&gt;원본 DDL&amp;nbsp; DATA_STATION/DB/production_schema.sql&lt;br&gt;자동 생성 ERD&amp;nbsp; UnityDT/Docs/db-schema.generated.md&lt;br&gt;칼럼 계약&amp;nbsp; UnityDT/Docs/DB.md&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#C9CFD8;strokeWidth=1.5;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;spacingLeft=16;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="1100" y="1080" width="700" height="230" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="design-principles" name="설계 원칙">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1150" pageHeight="700" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="p0"/>
        <mxCell id="p1" parent="p0"/>
        <mxCell id="c1" value="" style="rounded=1;arcSize=6;html=1;fillColor=#FFFFFF;strokeColor=#C9CFD8;strokeWidth=1.5;" vertex="1" parent="p1">
          <mxGeometry x="60" y="110" width="470" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="c1_n" value="1" style="ellipse;html=1;fillColor=#1F3864;strokeColor=none;fontColor=#FFFFFF;fontSize=13;fontStyle=1;" vertex="1" parent="p1">
          <mxGeometry x="76" y="126" width="28" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="c1_t" value="정상은 세지 않고 역산한다" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#1F3864;" vertex="1" parent="p1">
          <mxGeometry x="114" y="126" width="400" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="c1_b" value="검사 결과 중 &lt;b&gt;불량 슬롯만&lt;/b&gt; unit_defects 에 행으로 남긴다.&lt;br&gt;정상 수량은 검사 완료 units × product_slots 로 계산한다.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#B85450&quot;&gt;완성품 3대 × 슬롯 6곳 = 검사 18건, 저장은 불량 4행뿐&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;spacingTop=2;" vertex="1" parent="p1">
          <mxGeometry x="114" y="160" width="396" height="88" as="geometry"/>
        </mxCell>
        <mxCell id="c2" value="" style="rounded=1;arcSize=6;html=1;fillColor=#FFFFFF;strokeColor=#C9CFD8;strokeWidth=1.5;" vertex="1" parent="p1">
          <mxGeometry x="570" y="110" width="470" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="c2_n" value="2" style="ellipse;html=1;fillColor=#1F3864;strokeColor=none;fontColor=#FFFFFF;fontSize=13;fontStyle=1;" vertex="1" parent="p1">
          <mxGeometry x="586" y="126" width="28" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="c2_t" value="수량은 칼럼이 아니라 행으로 센다" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#1F3864;" vertex="1" parent="p1">
          <mxGeometry x="624" y="126" width="400" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="c2_b" value="jobs 에 완료 수량을 저장하지 않는다. requested_quantity 만 남기고&lt;br&gt;완료 수량은 COMPLETED 인 units 를 COUNT(*) 한다.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#B85450&quot;&gt;중복 저장이 없으므로 불일치가 구조적으로 생기지 않는다&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;spacingTop=2;" vertex="1" parent="p1">
          <mxGeometry x="624" y="160" width="396" height="88" as="geometry"/>
        </mxCell>
        <mxCell id="c3" value="" style="rounded=1;arcSize=6;html=1;fillColor=#FFFFFF;strokeColor=#C9CFD8;strokeWidth=1.5;" vertex="1" parent="p1">
          <mxGeometry x="60" y="290" width="470" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="c3_n" value="3" style="ellipse;html=1;fillColor=#1F3864;strokeColor=none;fontColor=#FFFFFF;fontSize=13;fontStyle=1;" vertex="1" parent="p1">
          <mxGeometry x="76" y="306" width="28" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="c3_t" value="구조와 방법을 분리한다" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#1F3864;" vertex="1" parent="p1">
          <mxGeometry x="114" y="306" width="400" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="c3_b" value="product_slots 는 &lt;b&gt;무엇이 어디에&lt;/b&gt; 들어가는지만 정의한다.&lt;br&gt;&lt;b&gt;어떤 순서·조건으로&lt;/b&gt; 넣는지는 로봇 레시피가 소유하고,&lt;br&gt;DB 는 jobs.recipe_version 으로 실행 사실만 기록한다.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#B85450&quot;&gt;순서를 두 곳에 두면 튜닝할 때마다 DB 값이 낡은 계획이 된다&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;spacingTop=2;" vertex="1" parent="p1">
          <mxGeometry x="114" y="340" width="396" height="88" as="geometry"/>
        </mxCell>
        <mxCell id="c4" value="" style="rounded=1;arcSize=6;html=1;fillColor=#FFFFFF;strokeColor=#C9CFD8;strokeWidth=1.5;" vertex="1" parent="p1">
          <mxGeometry x="570" y="290" width="470" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="c4_n" value="4" style="ellipse;html=1;fillColor=#1F3864;strokeColor=none;fontColor=#FFFFFF;fontSize=13;fontStyle=1;" vertex="1" parent="p1">
          <mxGeometry x="586" y="306" width="28" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="c4_t" value="두 가지 버전을 구분한다" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#1F3864;" vertex="1" parent="p1">
          <mxGeometry x="624" y="306" width="400" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="c4_b" value="&lt;b&gt;구조&lt;/b&gt; 변경 → 새 product_version. 과거 불량이 같은 슬롯을 계속 가리켜야 한다.&lt;br&gt;&lt;b&gt;방법&lt;/b&gt; 변경 → 새 recipe_version. 같은 제품 안에서 전후 비교가 유지된다.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#B85450&quot;&gt;불량 대책의 효과 검증이 이 구분 위에서 성립한다&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;spacingTop=2;" vertex="1" parent="p1">
          <mxGeometry x="624" y="340" width="396" height="88" as="geometry"/>
        </mxCell>
        <mxCell id="c5" value="" style="rounded=1;arcSize=6;html=1;fillColor=#FFFFFF;strokeColor=#C9CFD8;strokeWidth=1.5;" vertex="1" parent="p1">
          <mxGeometry x="60" y="470" width="470" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="c5_n" value="5" style="ellipse;html=1;fillColor=#1F3864;strokeColor=none;fontColor=#FFFFFF;fontSize=13;fontStyle=1;" vertex="1" parent="p1">
          <mxGeometry x="76" y="486" width="28" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="c5_t" value="확정된 기록은 고치지 않는다" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#1F3864;" vertex="1" parent="p1">
          <mxGeometry x="114" y="486" width="400" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="c5_b" value="첫 jobs 생성 시 definition_locked_at 으로 제품 &lt;b&gt;구조&lt;/b&gt;를 잠근다.&lt;br&gt;검사가 확정되면 units 와 unit_defects 도 추가만 하고 수정하지 않는다.&lt;br&gt;inventory_movements 는 append-only 원장으로 정정도 새 행으로 남긴다.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#B85450&quot;&gt;대책서가 발행 시점 집계를 스냅샷으로 갖기 때문에 필요하다&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;spacingTop=2;" vertex="1" parent="p1">
          <mxGeometry x="114" y="520" width="396" height="88" as="geometry"/>
        </mxCell>
        <mxCell id="c6" value="" style="rounded=1;arcSize=6;html=1;fillColor=#FFFFFF;strokeColor=#C9CFD8;strokeWidth=1.5;" vertex="1" parent="p1">
          <mxGeometry x="570" y="470" width="470" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="c6_n" value="6" style="ellipse;html=1;fillColor=#1F3864;strokeColor=none;fontColor=#FFFFFF;fontSize=13;fontStyle=1;" vertex="1" parent="p1">
          <mxGeometry x="586" y="486" width="28" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="c6_t" value="이 스키마의 경계를 지킨다" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#1F3864;" vertex="1" parent="p1">
          <mxGeometry x="624" y="486" width="400" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="c6_b" value="production 은 조립·검사 실행 기록과, 그 기록이 참조 무결성으로&lt;br&gt;의존하는 기준정보만 담는다. 레시피 본문·부품 데이터시트·&lt;br&gt;불량 임계 정책은 들어오지 않는다. control 스키마는 제거했고&lt;br&gt;jobs 가 영속 요청 큐를 겸한다.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#B85450&quot;&gt;품질 데이터시트와 대책서는 파일로 분리한다 → DB.md&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;spacingTop=2;" vertex="1" parent="p1">
          <mxGeometry x="624" y="520" width="396" height="88" as="geometry"/>
        </mxCell>
        <mxCell id="ptitle" value="production 스키마 설계 원칙" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1F3864;" vertex="1" parent="p1">
          <mxGeometry x="60" y="40" width="600" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="psubtitle" value="테이블과 열은 ERD 탭 · 칼럼 계약은 DB.md" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontSize=11;fontColor=#888888;" vertex="1" parent="p1">
          <mxGeometry x="640" y="46" width="400" height="28" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
