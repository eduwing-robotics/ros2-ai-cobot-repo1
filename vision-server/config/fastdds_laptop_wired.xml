<?xml version="1.0" encoding="UTF-8"?>
<!-- Optional wired-only ROS transport for the laptop. Wi-Fi stays enabled for
     SSH; this file limits Fast DDS discovery/data to the cell Ethernet plus
     loopback for local camera/ROI/control processes. Apply only after the
     TurtleBot has the matching 10.77.5.2/30 address and profile. -->
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <profiles>
    <transport_descriptors>
      <transport_descriptor>
        <transport_id>ksmc_udp_wired</transport_id>
        <type>UDPv4</type>
        <interfaceWhiteList>
          <interface>lo</interface>
          <interface>enp129s0</interface>
        </interfaceWhiteList>
        <non_blocking_send>true</non_blocking_send>
      </transport_descriptor>
      <transport_descriptor>
        <transport_id>ksmc_shm</transport_id>
        <type>SHM</type>
      </transport_descriptor>
    </transport_descriptors>
    <participant profile_name="ksmc_laptop_wired" is_default_profile="true">
      <rtps>
        <userTransports>
          <transport_id>ksmc_udp_wired</transport_id>
          <transport_id>ksmc_shm</transport_id>
        </userTransports>
        <useBuiltinTransports>false</useBuiltinTransports>
      </rtps>
    </participant>
  </profiles>
</dds>
